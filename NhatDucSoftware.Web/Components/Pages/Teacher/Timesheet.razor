@page "/teacher/timesheet"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject UserSession Session
@inject TeacherTimesheetService TimesheetService
@inject TeacherService TeacherService
@inject NavigationManager Nav
@using NhatDucSoftware.Core.Helpers

<PageTitle>Bảng chấm công</PageTitle>

@if (!Session.IsTeacher)
{
    <p>Không có quyền truy cập.</p>
}
else
{
    <h1 class="page-title">Bảng chấm công</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="card">
        <div class="toolbar">
            <label>Tháng</label>
            <select @bind="_month" @bind:after="LoadTimesheet">
                @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
            </select>
            <label>Năm</label>
            <select @bind="_year" @bind:after="LoadTimesheet">
                @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++) { <option value="@y">@y</option> }
            </select>
            <button class="btn btn-primary" @onclick="SaveTimesheet">Lưu chấm công</button>
            <span class="text-bold">Tổng ca: @_totalShifts</span>
        </div>
        <p class="text-muted">Giáo viên chỉ được chấm công trong ngày hôm nay. Nhập C/✓ (có mặt) hoặc ✗ (vắng). Mỗi ca có ghi chú riêng, lưu cùng ca đã chấm.</p>
        @if (_requiresPreschoolNote)
        {
            <p class="text-muted">Ghi chú bắt buộc theo mẫu Tên lớp: số đi học, số vắng(tên học sinh vắng). Ví dụ: @PreschoolTimesheetNote.Example</p>
        }
        @if (_isDualRole)
        {
            <p class="text-muted">Mỗi ca phải chọn Trung tâm hoặc Mầm non cạnh ô ghi chú.</p>
        }

        <div class="table-responsive">
            <table class="data-table timesheet-table">
                <thead>
                    <tr>
                        <th>Ngày</th>
                        @for (int s = 1; s <= 5; s++)
                        {
                            <th>@TeacherTimesheet.GetShiftDescription(s)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in _days)
                    {
                        <tr>
                            <td>@day.Label</td>
                            @for (int s = 1; s <= 5; s++)
                            {
                                var shift = s;
                                <td class="shift-cell">
                                    <div class="shift-stack">
                                        @if (day.IsToday)
                                        {
                                            <input class="input-shift" value="@GetShiftValue(day.Day, shift)" @onchange="e => SetShiftValue(day.Day, shift, e.Value?.ToString())" />
                                            <div class="shift-note-row">
                                                @if (_isDualRole)
                                                {
                                                    <select class="shift-place" value="@GetPlace(day, shift)" @onchange="e => SetPlace(day, shift, e.Value?.ToString())">
                                                        <option value="">Chọn</option>
                                                        <option value="@TeacherTimesheet.WorkPlaceCenter">Trung tâm</option>
                                                        <option value="@TeacherTimesheet.WorkPlacePreschool">Mầm non</option>
                                                    </select>
                                                }
                                                <input class="input-note" value="@GetNote(day, shift)" placeholder="@(_requiresPreschoolNote ? PreschoolTimesheetNote.Example : "Ghi chú")" @onchange="e => SetNote(day, shift, e.Value?.ToString())" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span>@GetShiftDisplay(day.Day, shift)</span>
                                            @if (_isDualRole && !string.IsNullOrWhiteSpace(GetPlace(day, shift)))
                                            {
                                                <span class="shift-note text-muted">@WorkPlaceLabel(GetPlace(day, shift))</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(GetNote(day, shift)))
                                            {
                                                <span class="shift-note text-muted">@GetNote(day, shift)</span>
                                            }
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private int _month = DateTime.Now.Month;
    private int _year = DateTime.Now.Year;
    private int _totalShifts;
    private bool _isDualRole;
    private bool _requiresPreschoolNote;
    private string? _message;
    private bool _messageIsError;
    private List<TeacherTimesheet> _records = new();
    private List<DayRow> _days = new();
    private Dictionary<(int Day, int Shift), string> _editValues = new();

    protected override void OnInitialized()
    {
        if (!Session.IsTeacher) { Nav.NavigateTo("/login"); return; }
        LoadTimesheet();
    }

    private void LoadTimesheet()
    {
        if (Session.CurrentUser?.TeacherId is not int teacherId) return;

        var teacher = TeacherService.GetAll().FirstOrDefault(t => t.Id == teacherId);
        _isDualRole = teacher is { IsCenterTeacher: true, IsPreschoolTeacher: true };
        _requiresPreschoolNote = teacher?.IsPreschoolTeacher == true;

        _records = TimesheetService.GetTimesheetByMonth(teacherId, _year, _month);
        _totalShifts = _records.Count(r => r.IsPresent);
        _editValues.Clear();

        var daysInMonth = DateTime.DaysInMonth(_year, _month);
        _days = Enumerable.Range(1, daysInMonth).Select(d =>
        {
            var date = new DateTime(_year, _month, d);
            var notes = new string[5];
            var places = new string[5];
            for (int s = 1; s <= 5; s++)
            {
                var record = _records.FirstOrDefault(r => r.WorkDate.Day == d && r.ShiftNumber == s);
                notes[s - 1] = record?.Note ?? "";
                places[s - 1] = record?.WorkPlace ?? "";
            }

            return new DayRow
            {
                Day = d,
                Label = $"{d:D2}/{_month:D2}/{_year}",
                IsToday = date.Date == DateTime.Today,
                Notes = notes,
                Places = places
            };
        }).ToList();
    }

    private string GetShiftDisplay(int day, int shift)
    {
        var rec = _records.FirstOrDefault(r => r.WorkDate.Day == day && r.ShiftNumber == shift);
        return rec is null ? "" : rec.IsPresent ? "✓" : "✗";
    }

    private string GetShiftValue(int day, int shift)
    {
        if (_editValues.TryGetValue((day, shift), out var v)) return v;
        return GetShiftDisplay(day, shift);
    }

    private void SetShiftValue(int day, int shift, string? value)
    {
        _editValues[(day, shift)] = (value ?? "").Trim();
    }

    private static string GetNote(DayRow day, int shift) => day.Notes[shift - 1];

    private static void SetNote(DayRow day, int shift, string? value)
    {
        day.Notes[shift - 1] = value ?? "";
    }

    private static string GetPlace(DayRow day, int shift) => day.Places[shift - 1];

    private static void SetPlace(DayRow day, int shift, string? value)
    {
        day.Places[shift - 1] = value ?? "";
    }

    private static string WorkPlaceLabel(string place) => place switch
    {
        TeacherTimesheet.WorkPlacePreschool => "Mầm non",
        TeacherTimesheet.WorkPlaceCenter => "Trung tâm",
        _ => ""
    };

    private void SaveTimesheet()
    {
        if (Session.CurrentUser?.TeacherId is not int teacherId) return;

        var skipped = 0;
        var pending = new List<(DateTime WorkDate, int Shift, bool IsPresent, string? Note, string? WorkPlace)>();
        foreach (var day in _days)
        {
            var workDate = new DateTime(_year, _month, day.Day);
            if (workDate.Date != DateTime.Today)
            {
                skipped++;
                continue;
            }

            for (int shift = 1; shift <= 5; shift++)
            {
                var cellValue = GetShiftValue(day.Day, shift).Trim().ToUpperInvariant();
                if (cellValue is not ("C" or "✓" or "✗")) continue;

                var note = GetNote(day, shift).Trim();
                var place = GetPlace(day, shift);
                if (_isDualRole && place is not (TeacherTimesheet.WorkPlaceCenter or TeacherTimesheet.WorkPlacePreschool))
                {
                    _messageIsError = true;
                    _message = $"Ca {shift}: chọn Trung tâm hoặc Mầm non.";
                    return;
                }

                if (_requiresPreschoolNote && !PreschoolTimesheetNote.IsValid(note, out var noteError))
                {
                    _messageIsError = true;
                    _message = $"Ca {shift}: {noteError}";
                    return;
                }

                string? workPlace = _isDualRole
                    ? place
                    : _requiresPreschoolNote ? TeacherTimesheet.WorkPlacePreschool : null;
                pending.Add((workDate, shift, cellValue is "C" or "✓", note.Length > 0 ? note : null, workPlace));
            }
        }

        foreach (var item in pending)
        {
            TimesheetService.SaveTimesheet(teacherId, item.WorkDate, item.Shift, item.IsPresent, item.Note, item.WorkPlace);
        }

        _messageIsError = false;
        _message = skipped > 0
            ? "Đã lưu chấm công. Giáo viên chỉ được chấm công trong ngày hôm nay."
            : "Đã lưu chấm công thành công!";
        LoadTimesheet();
    }

    private class DayRow
    {
        public int Day { get; set; }
        public string Label { get; set; } = "";
        public bool IsToday { get; set; }
        public string[] Notes { get; set; } = ["", "", "", "", ""];
        public string[] Places { get; set; } = ["", "", "", "", ""];
    }
}
