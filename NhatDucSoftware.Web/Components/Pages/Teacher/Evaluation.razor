@page "/teacher/evaluation"
@rendermode InteractiveServer
@inject UserSession Session
@inject ClassService ClassService
@inject StudentService StudentService
@inject EvaluationService EvaluationService
@inject NavigationManager Nav
@using NhatDucSoftware.Core.Models
@using NhatDucSoftware.Web.Helpers
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Nhận xét / Điểm</PageTitle>

@if (!Session.IsTeacher)
{
    <p>Không có quyền truy cập.</p>
}
else
{
    <h1 class="page-title">Nhận xét / Điểm</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="card">
        <div class="form-grid">
            <div class="form-group">
                <label>Lớp</label>
                <select @bind="_classId" @bind:after="LoadStudentsInClass">
                    @foreach (var c in _classes)
                    {
                        <option value="@c.Id">@c.ClassName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Học viên</label>
                <select @bind="_studentId">
                    @foreach (var s in _studentsInClass)
                    {
                        <option value="@s.Id">@s.FullName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Tháng</label>
                <select @bind="_month" @bind:after="OnPeriodChanged">
                    @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
                </select>
            </div>
            <div class="form-group">
                <label>Năm</label>
                <select @bind="_year" @bind:after="OnPeriodChanged">
                    @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++) { <option value="@y">@y</option> }
                </select>
            </div>
            <div class="form-group">
                <label>Điểm</label>
                <input @bind="_scoreText" />
            </div>
            <div class="form-group span-2">
                <label>Nhận xét</label>
                <textarea @bind="_comment" rows="3"></textarea>
            </div>
        </div>
        <button class="btn btn-primary" @onclick="SaveEvaluation">Lưu nhận xét/điểm</button>
    </div>

    <div class="card">
        <div class="report-section-header">
            <h3>Danh sách nhận xét / điểm — Tháng @_month/@_year</h3>
            <span class="text-muted">Thiếu: @MissingCount / @FilteredRows.Count</span>
        </div>

        <div class="toolbar">
            <label>Lớp</label>
            <select @bind="_filterClassId" @bind:after="OnFilterChanged">
                <option value="0">Tất cả</option>
                @foreach (var c in _classes)
                {
                    <option value="@c.Id">@c.ClassName</option>
                }
            </select>
            <label>Trạng thái</label>
            <select @bind="_filterStatus" @bind:after="OnFilterChanged">
                <option value="all">Tất cả</option>
                <option value="missing">Thiếu nhận xét</option>
                <option value="done">Đã có nhận xét</option>
            </select>
            <label>
                Hiển thị
                <select @bind="_pageSize" @bind:after="OnFilterChanged">
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
                / trang
            </label>
        </div>

        <div class="table-responsive">
            <table class="data-table compact">
                <thead>
                    <tr>
                        <th>Lớp</th>
                        <th>Học viên</th>
                        <th>Điểm</th>
                        <th>Nhận xét</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedRows.Count == 0)
                    {
                        <tr class="empty-row">
                            <td colspan="5">Không có học viên phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedRows)
                        {
                            <tr class="@(_classId == row.ClassId && _studentId == row.StudentId ? "selected" : "")"
                                style="cursor:pointer"
                                @onclick="() => SelectReviewRow(row)">
                                <td>@row.ClassName</td>
                                <td>@row.FullName</td>
                                <td>@(string.IsNullOrWhiteSpace(row.Diem) ? "—" : row.Diem)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.NhanXet) ? "—" : Truncate(row.NhanXet, 80))</td>
                                <td class="@(row.HasComment ? "status-ok" : "status-missing")">
                                    @(row.HasComment ? "Đã có" : "Thiếu nhận xét")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > 1)
        {
            <div class="pagination-bar">
                <button class="btn btn-secondary" @onclick="() => GoToPage(1)" disabled="@(_currentPage <= 1)">«</button>
                <button class="btn btn-secondary" @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">‹</button>
                @foreach (var p in VisiblePages)
                {
                    <button class="btn btn-secondary @(p == _currentPage ? "active" : "")" @onclick="() => GoToPage(p)">@p</button>
                }
                <button class="btn btn-secondary" @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">›</button>
                <button class="btn btn-secondary" @onclick="() => GoToPage(TotalPages)" disabled="@(_currentPage >= TotalPages)">»</button>
                <span class="pagination-info">Trang @_currentPage / @TotalPages</span>
            </div>
        }

        <p class="report-note">Bấm một dòng để điền vào form phía trên và bổ sung/cập nhật nhận xét.</p>
    </div>
}

@code {
    private List<ClassInfo> _classes = new();
    private List<Student> _studentsInClass = new();
    private List<Student> _allStudents = new();
    private List<ClassStudentEvaluationRow> _reviewRows = new();
    private int _classId;
    private int _studentId;
    private int _month = DateTime.Now.Month;
    private int _year = DateTime.Now.Year;
    private int _filterClassId;
    private string _filterStatus = "all";
    private int _pageSize = 15;
    private int _currentPage = 1;
    private string _scoreText = "";
    private string _comment = "";
    private string? _message;
    private bool _isError;

    private List<ClassStudentEvaluationRow> FilteredRows
    {
        get
        {
            IEnumerable<ClassStudentEvaluationRow> q = _reviewRows;
            if (_filterClassId > 0)
            {
                q = q.Where(x => x.ClassId == _filterClassId);
            }

            q = _filterStatus switch
            {
                "missing" => q.Where(x => !x.HasComment),
                "done" => q.Where(x => x.HasComment),
                _ => q
            };

            return q.OrderBy(x => x.ClassName).ThenBy(x => x.FullName).ToList();
        }
    }

    private int MissingCount => FilteredRows.Count(x => !x.HasComment);
    private int TotalPages => PaginationHelper.GetTotalPages(FilteredRows.Count, _pageSize);
    private List<ClassStudentEvaluationRow> PagedRows =>
        PaginationHelper.GetPage(FilteredRows, _currentPage, _pageSize);

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var start = Math.Max(1, _currentPage - 2);
            var end = Math.Min(TotalPages, _currentPage + 2);
            for (var p = start; p <= end; p++)
            {
                yield return p;
            }
        }
    }

    protected override void OnInitialized()
    {
        if (!Session.IsTeacher) { Nav.NavigateTo("/login"); return; }
        _allStudents = StudentService.GetAll();

        var deepLink = ReadDeepLinkFromQuery();
        if (deepLink is not null)
        {
            _month = deepLink.Value.Month;
            _year = deepLink.Value.Year;
        }

        LoadClassesForPeriod();

        if (deepLink is not null)
        {
            ApplyDeepLink(deepLink.Value.ClassId, deepLink.Value.StudentId);
        }

        LoadReviewRows();
        if (deepLink is not null)
        {
            _filterClassId = deepLink.Value.ClassId;
            _filterStatus = "missing";
            _message = "Đã mở form theo học viên cần bổ sung nhận xét.";
            _isError = false;
        }
    }

    private (int ClassId, int StudentId, int Month, int Year)? ReadDeepLinkFromQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("classId", out var classRaw)
            || !int.TryParse(classRaw, out var classId)
            || classId <= 0)
        {
            return null;
        }

        if (!query.TryGetValue("studentId", out var studentRaw)
            || !int.TryParse(studentRaw, out var studentId)
            || studentId <= 0)
        {
            return null;
        }

        var month = _month;
        var year = _year;
        if (query.TryGetValue("month", out var monthRaw) && int.TryParse(monthRaw, out var parsedMonth)
            && parsedMonth is >= 1 and <= 12)
        {
            month = parsedMonth;
        }

        if (query.TryGetValue("year", out var yearRaw) && int.TryParse(yearRaw, out var parsedYear)
            && parsedYear >= 2000)
        {
            year = parsedYear;
        }

        return (classId, studentId, month, year);
    }

    private void ApplyDeepLink(int classId, int studentId)
    {
        if (_classes.Any(c => c.Id == classId))
        {
            _classId = classId;
        }

        LoadStudentsInClass();

        if (_studentsInClass.Any(s => s.Id == studentId))
        {
            _studentId = studentId;
        }

        var existing = EvaluationService.GetByClassInMonth(_classId, _year, _month)
            .FirstOrDefault(x => x.StudentId == studentId);
        if (existing is not null)
        {
            _scoreText = existing.Diem ?? "";
            _comment = existing.NhanXet ?? "";
        }
        else
        {
            _scoreText = "";
            _comment = "";
        }
    }

    private void OnPeriodChanged()
    {
        LoadClassesForPeriod();
        LoadReviewRows();
        _currentPage = 1;
    }

    private void OnFilterChanged()
    {
        _currentPage = 1;
    }

    private void GoToPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalPages);
    }

    private void LoadClassesForPeriod()
    {
        if (Session.CurrentUser?.TeacherId is not int teacherId)
        {
            _classes = new();
            return;
        }

        var referenceDate = new DateTime(_year, _month, DateTime.DaysInMonth(_year, _month));
        _classes = ClassService.GetClassesByTeacher(teacherId, referenceDate)
            .Where(c => string.Equals(c.Status, "Active", StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.ClassName)
            .ToList();

        if (_classes.Count > 0)
        {
            if (!_classes.Any(c => c.Id == _classId))
            {
                _classId = _classes[0].Id;
            }

            if (_filterClassId > 0 && !_classes.Any(c => c.Id == _filterClassId))
            {
                _filterClassId = 0;
            }

            LoadStudentsInClass();
        }
        else
        {
            _classId = 0;
            _filterClassId = 0;
            _studentsInClass = new();
        }
    }

    private void LoadStudentsInClass()
    {
        var ids = ClassService.GetStudentsInClass(_classId).Select(s => s.StudentId).ToHashSet();
        _studentsInClass = _allStudents.Where(s => ids.Contains(s.Id)).ToList();
        if (_studentsInClass.Count > 0)
        {
            if (!_studentsInClass.Any(s => s.Id == _studentId))
            {
                _studentId = _studentsInClass[0].Id;
            }
        }
        else
        {
            _studentId = 0;
        }
    }

    private void LoadReviewRows()
    {
        _reviewRows = new();
        foreach (var cls in _classes)
        {
            var rows = EvaluationService.GetByClassInMonth(cls.Id, _year, _month);
            foreach (var row in rows)
            {
                row.ClassId = cls.Id;
                row.ClassName = cls.ClassName;
                _reviewRows.Add(row);
            }
        }
    }

    private void SelectReviewRow(ClassStudentEvaluationRow row)
    {
        _classId = row.ClassId;
        LoadStudentsInClass();
        _studentId = row.StudentId;
        _scoreText = row.Diem ?? "";
        _comment = row.NhanXet ?? "";
        _message = $"Đã chọn {row.FullName} — {row.ClassName}. Chỉnh sửa rồi bấm Lưu.";
        _isError = false;
    }

    private void SaveEvaluation()
    {
        if (Session.CurrentUser?.TeacherId is not int teacherId) return;

        if (_studentId <= 0 || _classId <= 0)
        {
            _message = "Vui lòng chọn lớp và học viên.";
            _isError = true;
            return;
        }

        try
        {
            EvaluationService.Save(
                _studentId,
                _classId,
                teacherId,
                decimal.TryParse(_scoreText, out var score) ? score : null,
                _comment.Trim(),
                _year,
                _month);

            _message = "Đã lưu nhận xét/điểm.";
            _isError = false;
            LoadReviewRows();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private static string Truncate(string text, int max)
    {
        if (string.IsNullOrWhiteSpace(text) || text.Length <= max)
        {
            return text;
        }

        return text[..max] + "…";
    }
}
