@page "/admin/teacher-schedules"
@rendermode InteractiveServer
@inject UserSession Session
@inject ClassScheduleService ScheduleService
@inject AttendanceService AttendanceService
@inject TeacherTimesheetService TimesheetService
@inject PaymentService PaymentService
@inject NavigationManager Nav
@using NhatDucSoftware.Core.Models

<PageTitle>Thời khóa biểu giáo viên</PageTitle>

@if (!Session.IsAdmin)
{
    <p>Không có quyền truy cập.</p>
}
else
{
    <h1 class="page-title">Thời khóa biểu giáo viên</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="card">
        <div class="toolbar">
            <label>Ngày</label>
            <input type="date" @bind="_selectedDate" @bind:after="LoadSchedule" />
            <span class="text-muted">@GetDayLabel()</span>
        </div>

        @if (_rows.Count == 0)
        {
            <p>Chưa có giáo viên trong hệ thống.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table schedule-matrix">
                    <thead>
                        <tr>
                            <th class="schedule-teacher-col">Giáo viên</th>
                            @for (int s = 1; s <= 5; s++)
                            {
                                <th class="schedule-shift-col">@TeacherTimesheet.GetShiftDescription(s)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr class="@(_selectedTeacherId == row.TeacherId ? "selected" : "")"
                                @onclick="() => SelectTeacher(row)">
                                <td class="schedule-teacher-col">@row.TeacherName</td>
                                @for (int s = 1; s <= 5; s++)
                                {
                                    var shift = s;
                                    <td class="schedule-cell">
                                        @if (row.HasShift(shift))
                                        {
                                            <span class="schedule-check" title="@row.GetShiftTooltip(shift)">✓</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_detail is not null)
    {
        <div class="card">
            <h3>Chi tiết — @_detail.TeacherName (@GetDayLabel())</h3>

            @if (_detail.Shifts.Count == 0)
            {
                <p class="text-muted">Giáo viên không có ca dạy trong ngày này.</p>
            }
            else
            {
                <div class="summary-panel class-summary">
                    <div class="summary-panel-title">Tổng hợp trong ngày</div>
                    <div class="summary-box">
                        <span>
                            Chấm công:
                            <span class="@GetStatusClass(_detail.AllTimesheetsComplete)">
                                @if (_detail.AllTimesheetsComplete)
                                {
                                    @:Đủ @_detail.RecordedShiftCount/@_detail.RequiredShiftCount ca
                                }
                                else
                                {
                                    @:Thiếu @(_detail.RequiredShiftCount - _detail.RecordedShiftCount)/@_detail.RequiredShiftCount ca
                                }
                            </span>
                        </span>
                        <span>
                            Điểm danh:
                            <span class="@GetStatusClass(_detail.AllAttendanceComplete)">
                                @if (_detail.AllAttendanceComplete)
                                {
                                    @:Đủ @_detail.CompletedClassShiftCount/@_detail.RequiredClassShiftCount lớp-ca
                                }
                                else
                                {
                                    @:Thiếu @(_detail.RequiredClassShiftCount - _detail.CompletedClassShiftCount)/@_detail.RequiredClassShiftCount lớp-ca
                                }
                            </span>
                        </span>
                    </div>
                </div>

                @foreach (var shift in _detail.Shifts)
                {
                    var shiftNumber = shift.ShiftNumber;
                    var isTimesheetEditOpen = IsTimesheetEditOpen(shiftNumber);
                    <div class="schedule-detail-shift">
                        <div class="schedule-detail-shift-header">
                            <strong>@TeacherTimesheet.GetShiftDescription(shiftNumber)</strong>
                            <span class="schedule-detail-meta @GetTimesheetHeaderClass(shift, isTimesheetEditOpen)"
                                  @onclick="() => OpenTimesheetEdit(shift)">
                                Chấm công:
                                <span class="@GetStatusClass(shift.TimesheetRecorded)">@GetTimesheetLabel(shift)</span>
                            </span>
                        </div>

                        @if (isTimesheetEditOpen)
                        {
                            <div class="timesheet-edit-panel">
                                <div class="attendance-edit-header">
                                    <strong>@(shift.TimesheetRecorded ? "Xem chấm công" : "Bổ sung chấm công") — @_detail.TeacherName</strong>
                                    <span class="text-muted">@TeacherTimesheet.GetShiftDescription(shiftNumber), @GetDayLabel()</span>
                                </div>

                                <div class="form-grid timesheet-edit-form">
                                    <div class="form-group">
                                        <label>Trạng thái</label>
                                        @if (shift.TimesheetRecorded)
                                        {
                                            <span class="@GetStatusClass(_timesheetPresent)">
                                                @(_timesheetPresent ? "Có mặt" : "Vắng")
                                            </span>
                                        }
                                        else
                                        {
                                            <label class="checkbox-inline">
                                                <input type="checkbox" @bind="_timesheetPresent" />
                                                Có mặt
                                            </label>
                                            <span class="text-muted">(bỏ chọn = vắng)</span>
                                        }
                                    </div>
                                    <div class="form-group">
                                        <label>Ghi chú</label>
                                        @if (shift.TimesheetRecorded)
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(_timesheetNote) ? "—" : _timesheetNote)</span>
                                        }
                                        else
                                        {
                                            <input @bind="_timesheetNote" placeholder="Ghi chú (tuỳ chọn)" />
                                        }
                                    </div>
                                </div>

                                <div class="toolbar">
                                    @if (!shift.TimesheetRecorded)
                                    {
                                        <button class="btn btn-primary"
                                                @onclick="() => SaveTimesheetEdit(shiftNumber)">
                                            Lưu chấm công
                                        </button>
                                    }
                                    <button class="btn btn-secondary" @onclick="CloseTimesheetEdit">Đóng</button>
                                </div>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="data-table compact">
                                <thead>
                                    <tr>
                                        <th>Lớp</th>
                                        <th>Điểm danh HS</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cls in shift.Classes)
                                    {
                                        var classId = cls.ClassId;
                                        var isEditOpen = IsAttendanceEditOpen(classId, shiftNumber);
                                        <tr class="@GetClassRowClass(cls, isEditOpen)"
                                            @onclick="() => OpenAttendanceEdit(cls, shiftNumber)">
                                            <td>@cls.ClassName</td>
                                            <td>@cls.RecordedStudents/@cls.TotalStudents học viên</td>
                                            <td>
                                                <span class="@GetStatusClass(cls.AttendanceComplete)">
                                                    @(cls.AttendanceComplete ? "Đủ — bấm để xem" : "Chưa đủ — bấm để bổ sung")
                                                </span>
                                            </td>
                                        </tr>
                                        @if (isEditOpen)
                                        {
                                            <tr class="attendance-edit-row">
                                                <td colspan="3">
                                                    <div class="attendance-edit-panel">
                                                        <div class="attendance-edit-header">
                                                            <strong>@(cls.AttendanceComplete ? "Xem điểm danh" : "Bổ sung điểm danh") — @cls.ClassName</strong>
                                                            <span class="text-muted">@TeacherTimesheet.GetShiftDescription(shiftNumber), @GetDayLabel()</span>
                                                        </div>

                                                        @if (!cls.AttendanceComplete)
                                                        {
                                                            var missingStudents = _attendanceRows.Where(r => !IsValidStatus(r.Status)).ToList();
                                                            @if (missingStudents.Count > 0)
                                                            {
                                                                <p class="attendance-missing-note">
                                                                    Học viên thiếu điểm danh:
                                                                    <strong>@string.Join(", ", missingStudents.Select(x => x.StudentName))</strong>
                                                                </p>
                                                            }
                                                        }

                                                        <div class="table-responsive">
                                                            <table class="data-table compact">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Học viên</th>
                                                                        <th>Điểm danh (C/V)</th>
                                                                        @if (!cls.AttendanceComplete)
                                                                        {
                                                                            <th>Ghi chú</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var student in _attendanceRows)
                                                                    {
                                                                        var missing = !IsValidStatus(student.Status);
                                                                        <tr class="@(missing && !cls.AttendanceComplete ? "attendance-missing-row" : "")">
                                                                            <td>@student.StudentName</td>
                                                                            <td>
                                                                                @if (cls.AttendanceComplete)
                                                                                {
                                                                                    <span class="@GetAttendanceStatusClass(student.Status)">@FormatAttendanceStatus(student.Status)</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <input class="input-attendance"
                                                                                           @bind="student.Status"
                                                                                           maxlength="1"
                                                                                           placeholder="C/V" />
                                                                                }
                                                                            </td>
                                                                            @if (!cls.AttendanceComplete)
                                                                            {
                                                                                <td>@(missing ? "Chưa điểm danh" : "Đã có")</td>
                                                                            }
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>

                                                        <div class="toolbar">
                                                            @if (!cls.AttendanceComplete)
                                                            {
                                                                <button class="btn btn-primary"
                                                                        @onclick="() => SaveAttendanceEdit(classId, shiftNumber)"
                                                                        disabled="@(!CanSaveAttendance)">
                                                                    Lưu điểm danh
                                                                </button>
                                                            }
                                                            <button class="btn btn-secondary" @onclick="CloseAttendanceEdit">Đóng</button>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        </div>
    }
}

@code {
    private DateTime _selectedDate = DateTime.Today;
    private List<TeacherDailyScheduleRow> _rows = new();
    private int? _selectedTeacherId;
    private TeacherDailyScheduleDetail? _detail;
    private int? _editClassId;
    private int? _editShiftNumber;
    private int? _editTimesheetShiftNumber;
    private bool _timesheetPresent = true;
    private string _timesheetNote = "";
    private List<AttendanceRow> _attendanceRows = new();
    private string? _message;
    private bool _isError;

    protected override void OnInitialized()
    {
        if (!Session.IsAdmin) { Nav.NavigateTo("/login"); return; }
        LoadSchedule();
    }

    private void LoadSchedule()
    {
        CloseAllEdits();
        _message = null;
        _rows = ScheduleService.GetAllTeachersScheduleForDate(_selectedDate.Date);
        if (_selectedTeacherId is int teacherId)
        {
            var row = _rows.FirstOrDefault(x => x.TeacherId == teacherId);
            if (row is not null)
            {
                LoadDetail(row);
                return;
            }
        }

        _selectedTeacherId = null;
        _detail = null;
    }

    private void SelectTeacher(TeacherDailyScheduleRow row)
    {
        CloseAllEdits();
        _message = null;
        _selectedTeacherId = row.TeacherId;
        LoadDetail(row);
    }

    private void LoadDetail(TeacherDailyScheduleRow row)
    {
        _detail = ScheduleService.GetTeacherDailyScheduleDetail(row.TeacherId, row.TeacherName, _selectedDate.Date);
    }

    private void ReloadDetail()
    {
        if (_selectedTeacherId is not int teacherId) return;
        var row = _rows.FirstOrDefault(x => x.TeacherId == teacherId);
        if (row is null) return;
        LoadDetail(row);
    }

    private void OpenAttendanceEdit(TeacherDailyClassDetail cls, int shiftNumber)
    {
        if (_detail is null)
        {
            return;
        }

        if (!cls.AttendanceComplete &&
            PaymentService.IsFinalized(cls.ClassId, _selectedDate.Month, _selectedDate.Year))
        {
            _message = $"Lớp {cls.ClassName} đã được chốt số liệu tháng {_selectedDate.Month:D2}/{_selectedDate.Year}, không thể điểm danh.";
            _isError = true;
            return;
        }

        if (_editClassId == cls.ClassId && _editShiftNumber == shiftNumber)
        {
            CloseAttendanceEdit();
            return;
        }

        CloseTimesheetEdit();
        _editClassId = cls.ClassId;
        _editShiftNumber = shiftNumber;
        _attendanceRows = AttendanceService.GetAttendanceRowsForClass(cls.ClassId, _selectedDate.Date, shiftNumber);
        _message = null;
    }

    private void CloseAttendanceEdit()
    {
        _editClassId = null;
        _editShiftNumber = null;
        _attendanceRows = new();
    }

    private void OpenTimesheetEdit(TeacherDailyShiftDetail shift)
    {
        if (_detail is null)
        {
            return;
        }

        if (_editTimesheetShiftNumber == shift.ShiftNumber)
        {
            CloseTimesheetEdit();
            return;
        }

        CloseAttendanceEdit();
        _editTimesheetShiftNumber = shift.ShiftNumber;

        if (shift.TimesheetRecorded)
        {
            _timesheetPresent = shift.TimesheetPresent == true;
            var records = TimesheetService.GetTimesheetByMonth(_detail.TeacherId, _selectedDate.Year, _selectedDate.Month);
            _timesheetNote = records
                .FirstOrDefault(r => r.WorkDate.Date == _selectedDate.Date && r.ShiftNumber == shift.ShiftNumber)?
                .Note ?? "";
        }
        else
        {
            _timesheetPresent = true;
            _timesheetNote = "";
        }

        _message = null;
    }

    private void CloseTimesheetEdit()
    {
        _editTimesheetShiftNumber = null;
        _timesheetPresent = true;
        _timesheetNote = "";
    }

    private void CloseAllEdits()
    {
        CloseAttendanceEdit();
        CloseTimesheetEdit();
    }

    private bool IsTimesheetEditOpen(int shiftNumber) =>
        _editTimesheetShiftNumber == shiftNumber;

    private void SaveTimesheetEdit(int shiftNumber)
    {
        if (_detail is null)
        {
            return;
        }

        if (_selectedDate.Date > DateTime.Today)
        {
            _message = "Chỉ được chấm công bù cho các ngày từ hôm nay trở về trước.";
            _isError = true;
            return;
        }

        TimesheetService.SaveTimesheet(
            _detail.TeacherId,
            _selectedDate.Date,
            shiftNumber,
            _timesheetPresent,
            string.IsNullOrWhiteSpace(_timesheetNote) ? null : _timesheetNote.Trim());
        _message = "Đã lưu chấm công.";
        _isError = false;
        CloseTimesheetEdit();
        ReloadDetail();
    }

    private bool IsAttendanceEditOpen(int classId, int shiftNumber) =>
        _editClassId == classId && _editShiftNumber == shiftNumber;

    private bool CanSaveAttendance =>
        _attendanceRows.Count > 0 && _attendanceRows.All(r => IsValidStatus(r.Status));

    private void SaveAttendanceEdit(int classId, int shiftNumber)
    {
        if (_detail is null) return;

        if (PaymentService.IsFinalized(classId, _selectedDate.Month, _selectedDate.Year))
        {
            _message = $"Lớp này đã được chốt số liệu tháng {_selectedDate.Month:D2}/{_selectedDate.Year}.";
            _isError = true;
            return;
        }

        var invalid = _attendanceRows.FirstOrDefault(r => !IsValidStatus(r.Status));
        if (invalid is not null)
        {
            _message = $"Học viên '{invalid.StudentName}' phải nhập C hoặc V.";
            _isError = true;
            return;
        }

        var records = _attendanceRows.ToDictionary(x => x.StudentId, x => x.Status.Trim().ToUpperInvariant());
        AttendanceService.SaveAttendance(classId, _detail.TeacherId, _selectedDate.Date, shiftNumber, records);
        _message = "Đã lưu điểm danh.";
        _isError = false;
        CloseAttendanceEdit();
        ReloadDetail();
    }

    private string GetDayLabel()
    {
        var dayIndex = _selectedDate.DayOfWeek switch
        {
            DayOfWeek.Monday => 0,
            DayOfWeek.Tuesday => 1,
            DayOfWeek.Wednesday => 2,
            DayOfWeek.Thursday => 3,
            DayOfWeek.Friday => 4,
            DayOfWeek.Saturday => 5,
            DayOfWeek.Sunday => 6,
            _ => 0
        };

        return $"{ClassWeeklySchedule.GetDayName(dayIndex)}, {_selectedDate:dd/MM/yyyy}";
    }

    private static string GetTimesheetLabel(TeacherDailyShiftDetail shift) =>
        shift.TimesheetRecorded
            ? shift.TimesheetPresent == true ? "Đã chấm — Có mặt — bấm để xem" : "Đã chấm — Vắng — bấm để xem"
            : "Chưa chấm — bấm để bổ sung";

    private static string GetTimesheetHeaderClass(TeacherDailyShiftDetail shift, bool isEditOpen)
    {
        var baseClass = shift.TimesheetRecorded ? "schedule-timesheet-complete" : "schedule-timesheet-missing";
        return isEditOpen ? $"{baseClass} selected" : baseClass;
    }

    private static string GetStatusClass(bool ok) => ok ? "status-ok" : "status-missing";

    private static string GetClassRowClass(TeacherDailyClassDetail cls, bool isEditOpen)
    {
        var baseClass = cls.AttendanceComplete ? "schedule-class-complete" : "schedule-class-missing";
        return isEditOpen ? $"{baseClass} selected" : baseClass;
    }

    private static string FormatAttendanceStatus(string? status)
    {
        var normalized = (status ?? "").Trim().ToUpperInvariant();
        return normalized switch
        {
            "C" => "C — Có mặt",
            "V" => "V — Vắng",
            _ => "—"
        };
    }

    private static string GetAttendanceStatusClass(string? status) =>
        (status ?? "").Trim().ToUpperInvariant() switch
        {
            "C" => "status-ok",
            "V" => "status-missing",
            _ => ""
        };

    private static bool IsValidStatus(string? status)
    {
        var normalized = (status ?? "").Trim().ToUpperInvariant();
        return normalized is "C" or "V";
    }
}
