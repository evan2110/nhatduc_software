@page "/admin/payments"
@rendermode InteractiveServer
@inject UserSession Session
@inject PaymentService PaymentService
@inject ClassService ClassService
@inject NavigationManager Nav

<PageTitle>Học phí</PageTitle>

@if (!Session.IsAdmin)
{
    <p>Không có quyền truy cập.</p>
}
else
{
    <h1 class="page-title">Quản lý học phí</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-info")">@_message</div>
    }

    <div class="card">
        <div class="toolbar">
            <label>Lớp</label>
            <select @bind="_classId" @bind:after="LoadGrid">
                <option value="0">Tất cả</option>
                @foreach (var c in _classes)
                {
                    <option value="@c.Id">@c.ClassName</option>
                }
            </select>
            <label>Tháng</label>
            <select @bind="_month" @bind:after="LoadGrid">
                @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
            </select>
            <label>Năm</label>
            <select @bind="_year" @bind:after="LoadGrid">
                @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 1; y++) { <option value="@y">@y</option> }
            </select>
            <a class="btn btn-success" href="@($"/api/export/payments/{_month}/{_year}/{_classId}")" target="_blank">Xuất Excel</a>
            <button class="btn btn-primary" @onclick="FinalizeMonth" disabled="@(_isFinalized || _classId <= 0)">Chốt số liệu</button>
        </div>

        <div class="summary-panel class-summary">
            <div class="summary-panel-title">@(_classId <= 0 ? "Tổng học phí toàn trung tâm" : "Tổng học phí cả lớp")</div>
            <div class="summary-box">
                <span>Tổng cần đóng: @MoneyHelper.FormatCurrency(_summary.TotalDue)</span>
                <span>Tổng đã đóng: @MoneyHelper.FormatCurrency(_summary.TotalPaid)</span>
                <span>Tổng còn lại: @MoneyHelper.FormatCurrency(_summary.TotalRemaining)</span>
            </div>
        </div>

        <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th>TT</th><th>Họ tên</th><th>Lớp</th><th>Ngày thu</th><th>Số tiền</th><th>Người thu</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var row in _paymentRows)
                {
                    <tr class="@(row.StudentId == 0 ? "total-row" : _selectedStudentId == row.StudentId ? "selected" : "")"
                        @onclick="() => SelectPaymentRow(row)">
                        <td>@(row.StudentId == 0 ? "" : row.ThuTu.ToString())</td>
                        <td>@row.HoVaTen</td>
                        <td>@row.Lop</td>
                        <td>@row.NgayThu</td>
                        <td>@MoneyHelper.FormatCurrency(row.SoTien)</td>
                        <td>@row.NguoiThu</td>
                        <td>
                            @if (row.StudentId > 0)
                            {
                                <button class="btn btn-secondary btn-sm" @onclick:stopPropagation="true" @onclick="() => ShowDetail(row)">Chi tiết</button>
                                <button class="btn btn-primary btn-sm" @onclick:stopPropagation="true" @onclick="() => PayFromBalance(row)" disabled="@(_isFinalized || _classId <= 0)">Thanh toán</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    @if (_selectedStudentId > 0)
    {
        <div class="card">
            <div class="summary-panel student-summary">
                <div class="summary-panel-title">Theo học viên: @_selectedStudentName</div>
                <div class="summary-box">
                    <span>@_needText</span>
                    <span>Đã đóng: @MoneyHelper.FormatCurrency(_paid)</span>
                    <span>Còn lại: @MoneyHelper.FormatCurrency(_remaining)</span>
                    <span>Số dư: @MoneyHelper.FormatCurrency(_balance)</span>
                </div>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Số tiền thu</label>
                    <input @bind="_amountText" />
                </div>
                <div class="form-group">
                    <label>Ghi chú</label>
                    <input @bind="_note" />
                </div>
            </div>
            <button class="btn btn-primary" @onclick="CollectPayment" disabled="@(_remaining <= 0 || _isFinalized || _classId <= 0)">Thu học phí</button>
            <button class="btn btn-secondary" @onclick="PayFromBalanceSelected" disabled="@(_remaining <= 0 || _balance <= 0 || _isFinalized || _classId <= 0)">Thanh toán từ số dư</button>
            @if (_classId <= 0 && _classTuitionBreakdown.Count > 0)
            {
                <div class="table-responsive" style="margin-top: 1rem;">
                    <table class="data-table compact">
                        <thead>
                            <tr><th>Lớp</th><th>Cần đóng</th><th>Đã đóng</th><th>Còn lại</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _classTuitionBreakdown)
                            {
                                <tr>
                                    <td>@item.ClassName</td>
                                    <td>
                                        @MoneyHelper.FormatCurrency(item.TotalDue)
                                        @if (item.CarryOver > 0)
                                        {
                                            <span class="text-muted"> (nợ từ tháng trước: @MoneyHelper.FormatCurrency(item.CarryOver))</span>
                                        }
                                    </td>
                                    <td>@MoneyHelper.FormatCurrency(item.Paid)</td>
                                    <td>@MoneyHelper.FormatCurrency(item.Remaining)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (_showDetail)
    {
        <div class="modal-backdrop" @onclick="() => _showDetail = false">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Chi tiết thu phí - @_detailStudentName</h3>
                @if (_classId <= 0 && _detailClassBreakdown.Count > 0)
                {
                    <div class="table-responsive" style="margin-bottom: 1rem;">
                        <table class="data-table compact">
                            <thead>
                                <tr><th>Lớp</th><th>Cần đóng</th><th>Đã đóng</th><th>Còn lại</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _detailClassBreakdown)
                                {
                                    <tr>
                                        <td>@item.ClassName</td>
                                        <td>@MoneyHelper.FormatCurrency(item.TotalDue)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.Paid)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.Remaining)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="table-responsive">
                <table class="data-table compact">
                    <thead><tr><th>Ngày thu</th>@if (_classId <= 0) { <th>Lớp</th> }<th>Số tiền</th><th>Người thu</th><th>Ghi chú</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var h in _detailHistory)
                        {
                            <tr>
                                <td>@h.NgayThu</td>
                                @if (_classId <= 0) { <td>@(string.IsNullOrEmpty(h.Lop) ? "—" : h.Lop)</td> }
                                <td>@MoneyHelper.FormatCurrency(h.SoTien)</td>
                                <td>@h.NguoiThu</td>
                                <td>@h.GhiChu</td>
                                <td>
                                    @if (!_isFinalized && Session.CanDeletePaymentHistory)
                                    {
                                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteHistory(h.PaymentId)">Xóa</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <button class="btn btn-secondary" @onclick="() => _showDetail = false">Đóng</button>
            </div>
        </div>
    }
}

@code {
    private List<ClassInfo> _classes = new();
    private List<PaymentClassListRow> _paymentRows = new();
    private int _classId;
    private int _month = DateTime.Now.Month;
    private int _year = DateTime.Now.Year;
    private int _selectedStudentId;
    private string _selectedStudentName = "";
    private decimal _paid;
    private decimal _remaining;
    private decimal _balance;
    private string _needText = "";
    private string _amountText = "";
    private string _note = "";
    private string? _message;
    private bool _isError;
    private bool _isFinalized;
    private bool _showDetail;
    private int _detailStudentId;
    private string _detailStudentName = "";
    private List<PaymentHistoryRow> _detailHistory = new();
    private List<StudentClassTuitionRow> _classTuitionBreakdown = new();
    private List<StudentClassTuitionRow> _detailClassBreakdown = new();
    private ClassPaymentSummary _summary = new();

    protected override void OnInitialized()
    {
        if (!Session.IsAdmin) { Nav.NavigateTo("/login"); return; }
        _classes = ClassService.GetAll();
        if (_classes.Count > 0) _classId = _classes[0].Id;
        LoadGrid();
    }

    private void LoadGrid()
    {
        _isFinalized = _classId > 0 && PaymentService.IsFinalized(_classId, _month, _year);
        _summary = PaymentService.GetClassPaymentSummary(_classId, _month, _year);
        var list = PaymentService.GetPaymentListByClassMonthYear(_classId, _month, _year);
        _paymentRows = list.ToList();
        _paymentRows.Add(new PaymentClassListRow
        {
            HoVaTen = "Tổng cộng",
            SoTien = list.Sum(x => x.SoTien)
        });

        var first = list.FirstOrDefault();
        if (first is not null) SelectPaymentRow(first);
        else { _selectedStudentId = 0; _classTuitionBreakdown.Clear(); }
    }

    private void SelectPaymentRow(PaymentClassListRow row)
    {
        if (row.StudentId <= 0) return;
        _selectedStudentId = row.StudentId;
        _selectedStudentName = row.HoVaTen;
        var total = PaymentService.GetTotalTuitionByStudentInClassMonthYear(row.StudentId, _classId, _month, _year);
        _paid = PaymentService.GetPaidAmountByStudentMonthYear(row.StudentId, _month, _year, _classId);
        _remaining = Math.Max(0, total - _paid);
        _balance = PaymentService.GetStudentBalance(row.StudentId);
        var carryOver = PaymentService.GetCarryOverAmount(row.StudentId, _classId, _month, _year);
        _needText = $"Cần đóng: {MoneyHelper.FormatCurrency(total)}";
        if (carryOver > 0) _needText += $" (nợ từ tháng trước: {MoneyHelper.FormatCurrency(carryOver)})";
        _classTuitionBreakdown = _classId <= 0
            ? PaymentService.GetStudentTuitionBreakdownByClassMonthYear(row.StudentId, _month, _year)
            : new List<StudentClassTuitionRow>();
    }

    private void CollectPayment()
    {
        if (_selectedStudentId <= 0) return;

        if (_month != DateTime.Now.Month || _year != DateTime.Now.Year)
        {
            _message = "Chỉ được phép thu học phí của tháng hiện tại.";
            _isError = true;
            return;
        }

        if (!MoneyHelper.TryParseMoney(_amountText, out var amount) || amount <= 0)
        {
            _message = "Số tiền thu bắt buộc phải lớn hơn 0.";
            _isError = true;
            return;
        }

        if (amount > _remaining)
        {
            _message = $"Số tiền thu không được lớn hơn số còn lại ({MoneyHelper.FormatCurrency(_remaining)}).";
            _isError = true;
            return;
        }

        try
        {
            PaymentService.Collect(_selectedStudentId, amount, Session.CurrentUser!.Id, _note.Trim(), _classId);
            _message = "Đã thu học phí.";
            _isError = false;
            _amountText = "";
            _note = "";
            LoadGrid();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private void PayFromBalance(PaymentClassListRow row)
    {
        SelectPaymentRow(row);
        PayFromBalanceSelected();
    }

    private void PayFromBalanceSelected()
    {
        if (_selectedStudentId <= 0) return;

        if (_month != DateTime.Now.Month || _year != DateTime.Now.Year)
        {
            _message = "Chỉ được phép thanh toán học phí của tháng hiện tại.";
            _isError = true;
            return;
        }

        if (_balance <= 0)
        {
            _message = "Học viên không có số dư để thanh toán.";
            _isError = true;
            return;
        }

        if (_remaining <= 0)
        {
            _message = "Học viên không còn học phí cần đóng.";
            _isError = true;
            return;
        }

        try
        {
            var amount = PaymentService.PayFromBalance(_selectedStudentId, _classId, _month, _year, Session.CurrentUser!.Id);
            _message = $"Đã thanh toán {MoneyHelper.FormatCurrency(amount)} từ số dư.";
            _isError = false;
            LoadGrid();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private void FinalizeMonth()
    {
        var today = DateTime.Today;
        if (today.Day != DateTime.DaysInMonth(today.Year, today.Month))
        {
            _message = $"Chỉ có thể chốt số liệu vào ngày cuối cùng của tháng (ngày {DateTime.DaysInMonth(today.Year, today.Month)}).";
            _isError = true;
            return;
        }

        if (_classId <= 0)
        {
            _message = "Vui lòng chọn một lớp cụ thể.";
            _isError = true;
            return;
        }

        try
        {
            PaymentService.FinalizePayment(_classId, _month, _year, Session.CurrentUser!.Id);
            _message = $"Đã chốt số liệu tháng {_month:D2}/{_year}.";
            _isError = false;
            LoadGrid();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private void ShowDetail(PaymentClassListRow row)
    {
        try
        {
            _detailStudentId = row.StudentId;
            _detailStudentName = row.HoVaTen;
            _detailHistory = PaymentService.GetPaymentHistoryByClassMonthYear(row.StudentId, _classId, _month, _year);
            _detailClassBreakdown = _classId <= 0
                ? PaymentService.GetStudentTuitionBreakdownByClassMonthYear(row.StudentId, _month, _year)
                : new List<StudentClassTuitionRow>();
            _showDetail = true;
            _isError = false;
        }
        catch (Exception ex)
        {
            _showDetail = false;
            _message = $"Không thể tải chi tiết thu phí: {ex.Message}";
            _isError = true;
        }
    }

    private void DeleteHistory(int paymentId)
    {
        if (!Session.CanDeletePaymentHistory)
        {
            _message = "Bạn không có quyền xóa lịch sử thu phí.";
            _isError = true;
            return;
        }

        try
        {
            PaymentService.DeletePaymentHistory(paymentId, _detailStudentId);
            _detailHistory = PaymentService.GetPaymentHistoryByClassMonthYear(_detailStudentId, _classId, _month, _year);
            LoadGrid();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }
}
