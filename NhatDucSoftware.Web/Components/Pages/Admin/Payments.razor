@page "/admin/payments"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject UserSession Session
@inject PaymentService PaymentService
@inject ClassService ClassService
@inject LoadingService Loading
@inject NavigationManager Nav

<PageTitle>Học phí</PageTitle>

@if (!Session.IsAdmin)
{
    <p>Không có quyền truy cập.</p>
}
else
{
    <h1 class="page-title">Quản lý học phí</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-info")">@_message</div>
    }

    <div class="card">
        <div class="toolbar">
            <label>Lớp</label>
            <select @bind="_classId" @bind:after="OnFilterChanged">
                <option value="0">Tất cả</option>
                @foreach (var c in _classes)
                {
                    <option value="@c.Id">@c.ClassName</option>
                }
            </select>
            <label>Tháng</label>
            <select @bind="_month" @bind:after="OnFilterChanged">
                @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
            </select>
            <label>Năm</label>
            <select @bind="_year" @bind:after="OnFilterChanged">
                @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 1; y++) { <option value="@y">@y</option> }
            </select>
            <a class="btn btn-success" href="@($"/api/export/payments/{_month}/{_year}/{_classId}")" target="_blank">Xuất Excel</a>
            <a class="btn btn-success" href="@ClassTuitionExportUrl" target="_blank">Xuất Excel theo lớp</a>
            <button class="btn btn-secondary" @onclick="OpenDiscountManager">Quản lý giảm phí</button>
            <button class="btn btn-primary" @onclick="OpenFinalizeConfirm" disabled="@IsFinalizeButtonDisabled">
                @(_classId <= 0 ? "Chốt hàng loạt" : "Chốt số liệu")
            </button>
        </div>

        <div class="summary-panel class-summary summary-panel-clickable" role="button" tabindex="0" @onclick="OpenMonthDetail" @onkeydown="OnMonthDetailKeyDown">
            <div class="summary-panel-title">@(_classId <= 0 ? "Tổng học phí toàn trung tâm" : "Tổng học phí cả lớp")</div>
            <div class="summary-box">
                <span>
                    Tổng cần đóng: @MoneyHelper.FormatCurrency(_summary.TotalDue)
                    @if (_summary.TotalCarryOver > 0)
                    {
                        <span class="text-muted"> (học phí tháng: @MoneyHelper.FormatCurrency(_summary.TotalAttendanceDue), nợ chuyển: @MoneyHelper.FormatCurrency(_summary.TotalCarryOver))</span>
                    }
                </span>
                <span>Tổng đã đóng: @MoneyHelper.FormatCurrency(_summary.TotalPaid)</span>
                <span>Tổng còn lại: @MoneyHelper.FormatCurrency(_summary.TotalRemaining)</span>
            </div>
            <p class="summary-panel-hint">Bấm để xem học phí từng học viên theo lớp.</p>
        </div>

        <div class="list-toolbar">
            <div class="search-box">
                <input type="search"
                       placeholder="Tìm theo tên hoặc lớp..."
                       value="@_searchText"
                       @oninput="OnSearchChanged" />
            </div>
            <div class="list-meta">
                <span>@FilteredCount học viên</span>
                <label>
                    Hiển thị
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    / trang
                </label>
            </div>
        </div>

        <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th>TT</th><th>Họ tên</th><th>Lớp</th><th>Ngày thu</th><th>Số tiền cần đóng</th><th>Số tiền đã thu</th><th>Số tiền còn lại</th><th>Người thu</th><th></th></tr>
            </thead>
            <tbody>
                @if (PagedPaymentRows.Count == 0)
                {
                    <tr class="empty-row">
                        <td colspan="9">Không tìm thấy học viên phù hợp.</td>
                    </tr>
                }
                else
                {
                    @for (var i = 0; i < PagedPaymentRows.Count; i++)
                    {
                        var row = PagedPaymentRows[i];
                        var rowIndex = (_currentPage - 1) * _pageSize + i + 1;
                        var remaining = row.SoTienConLai;
                        <tr class="@(_selectedStudentId == row.StudentId ? "selected" : "")"
                            @onclick="() => SelectPaymentRow(row)">
                            <td>@rowIndex</td>
                            <td>@row.HoVaTen</td>
                            <td>@row.Lop</td>
                            <td>@row.NgayThu</td>
                            <td>@MoneyHelper.FormatCurrency(row.SoTienCanDong)</td>
                            <td>@MoneyHelper.FormatCurrency(row.SoTien)</td>
                            <td class="amount-remaining">@MoneyHelper.FormatCurrency(remaining)</td>
                            <td>@row.NguoiThu</td>
                            <td>
                                <div class="table-actions">
                                    @if (Session.CanManageTuitionDiscount)
                                    {
                                        <button class="btn btn-success btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenDiscountModal(row)">Giảm phí</button>
                                    }
                                    <button class="btn btn-secondary btn-sm" @onclick:stopPropagation="true" @onclick="() => ShowDetail(row)">Chi tiết</button>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr class="total-row">
                        <td></td>
                        <td>Tổng cộng</td>
                        <td colspan="2"></td>
                        <td>@MoneyHelper.FormatCurrency(FilteredTotalDue)</td>
                        <td>@MoneyHelper.FormatCurrency(FilteredTotalPaid)</td>
                        <td class="amount-remaining">@MoneyHelper.FormatCurrency(FilteredTotalRemaining)</td>
                        <td colspan="2"></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        @if (TotalPages > 1)
        {
            <div class="pagination-bar">
                <button class="btn btn-secondary" @onclick="() => GoToPage(1)" disabled="@(_currentPage <= 1)">«</button>
                <button class="btn btn-secondary" @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">‹</button>
                @foreach (var p in VisiblePages)
                {
                    <button class="btn btn-secondary @(p == _currentPage ? "active" : "")" @onclick="() => GoToPage(p)">@p</button>
                }
                <button class="btn btn-secondary" @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">›</button>
                <button class="btn btn-secondary" @onclick="() => GoToPage(TotalPages)" disabled="@(_currentPage >= TotalPages)">»</button>
                <span class="pagination-info">Trang @_currentPage / @TotalPages</span>
            </div>
        }
    </div>

    @if (_selectedStudentId > 0)
    {
        <div class="card">
            <div class="summary-panel student-summary">
                <div class="summary-panel-title">Theo học viên: @_selectedStudentName</div>
                <div class="summary-box">
                    <span>@_needText</span>
                    <span>Đã đóng: @MoneyHelper.FormatCurrency(_paid)</span>
                    <span>Còn lại: @MoneyHelper.FormatCurrency(_remaining)</span>
                    <span>Số dư: @MoneyHelper.FormatCurrency(_balance)</span>
                </div>
            </div>
            @if (_classId == 0)
            {
                <div class="form-grid">
                    <div class="form-group">
                        <label>Số tiền thu</label>
                        <input @bind="_amountText" />
                    </div>
                    <div class="form-group">
                        <label>Ghi chú</label>
                        <input @bind="_note" />
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="CollectPayment" disabled="@(!CanCollectPayment)">Thu học phí</button>
                <button class="btn btn-secondary" @onclick="PayFromBalanceSelected" disabled="@(!CanPayFromBalance)">Thanh toán từ số dư</button>
            }
        </div>
    }

    @if (_showMonthDetail)
    {
        <div class="modal-backdrop" @onclick="CloseMonthDetail">
            <div class="modal-content modal-tuition" @onclick:stopPropagation="true">
                <h3>Chi tiết học phí tháng @_month.ToString("D2")/@_year</h3>
                <a class="btn btn-success" href="@ClassTuitionExportUrl" target="_blank">Xuất Excel</a>
                @if (_monthClassDetails.Count == 0)
                {
                    <p class="text-muted">Không có học phí học viên trong tháng này.</p>
                }
                else
                {
                    @foreach (var group in _monthClassDetails)
                    {
                        <section class="tuition-class-section">
                            <h4>@group.ClassName</h4>
                            <p class="text-muted">
                                @group.Students.Count học viên
                                · Cần đóng @MoneyHelper.FormatCurrency(group.TotalDue)
                                · Đã đóng @MoneyHelper.FormatCurrency(group.Paid)
                                · Còn lại @MoneyHelper.FormatCurrency(group.Remaining)
                            </p>
                            <div class="table-responsive">
                                <table class="data-table compact">
                                    <thead>
                                        <tr>
                                            <th>Họ tên</th>
                                            <th>Học phí tháng</th>
                                            <th>Giảm</th>
                                            <th>Nợ chuyển</th>
                                            <th>Cần đóng</th>
                                            <th>Đã đóng</th>
                                            <th>Còn lại</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var student in group.Students)
                                        {
                                            <tr>
                                                <td>@student.Name</td>
                                                <td>@MoneyHelper.FormatCurrency(student.GrossAttendance)</td>
                                                <td>@MoneyHelper.FormatCurrency(student.DiscountAmount)</td>
                                                <td>@MoneyHelper.FormatCurrency(student.CarryOver)</td>
                                                <td>@MoneyHelper.FormatCurrency(student.TotalDue)</td>
                                                <td>@MoneyHelper.FormatCurrency(student.Paid)</td>
                                                <td class="amount-remaining">@MoneyHelper.FormatCurrency(student.Remaining)</td>
                                            </tr>
                                        }
                                        <tr class="total-row">
                                            <td>Tổng lớp</td>
                                            <td>@MoneyHelper.FormatCurrency(group.GrossAttendance)</td>
                                            <td>@MoneyHelper.FormatCurrency(group.DiscountAmount)</td>
                                            <td>@MoneyHelper.FormatCurrency(group.CarryOver)</td>
                                            <td>@MoneyHelper.FormatCurrency(group.TotalDue)</td>
                                            <td>@MoneyHelper.FormatCurrency(group.Paid)</td>
                                            <td class="amount-remaining">@MoneyHelper.FormatCurrency(group.Remaining)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                }
                <button class="btn btn-secondary" @onclick="CloseMonthDetail">Đóng</button>
            </div>
        </div>
    }

    @if (_showDetail)
    {
        <div class="modal-backdrop" @onclick="() => _showDetail = false">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Chi tiết thu phí - @_detailStudentName</h3>
                @if (VisibleDetailBreakdown.Any())
                {
                    <div class="table-responsive" style="margin-bottom: 1rem;">
                        <h3>Còn lại theo lớp</h3>
                        <table class="data-table compact">
                            <thead>
                                <tr><th>Lớp</th><th>Học phí gốc</th><th>Giảm</th><th>Cần đóng</th><th>Đã đóng</th><th>Còn lại</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in VisibleDetailBreakdown)
                                {
                                    <tr class="@(_classId == item.ClassId ? "selected" : "")">
                                        <td>@item.ClassName</td>
                                        <td>@MoneyHelper.FormatCurrency(item.GrossAttendance)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.DiscountAmount)</td>
                                        <td>
                                            @MoneyHelper.FormatCurrency(item.TotalDue)
                                            @if (item.CarryOver > 0)
                                            {
                                                <span class="text-muted"> (nợ chuyển từ tháng trước: @MoneyHelper.FormatCurrency(item.CarryOver))</span>
                                            }
                                        </td>
                                        <td>@MoneyHelper.FormatCurrency(item.Paid)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.Remaining)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="table-responsive">
                <table class="data-table compact">
                    <thead><tr><th>Ngày thu</th>@if (_classId <= 0) { <th>Lớp</th> }<th>Số tiền</th><th>Người thu</th><th>Ghi chú</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var h in _detailHistory)
                        {
                            <tr>
                                <td>@h.NgayThu</td>
                                @if (_classId <= 0) { <td>@(string.IsNullOrEmpty(h.Lop) ? "—" : h.Lop)</td> }
                                <td>@MoneyHelper.FormatCurrency(h.SoTien)</td>
                                <td>@h.NguoiThu</td>
                                <td>@h.GhiChu</td>
                                <td>
                                    @if (Session.CanDeletePaymentHistory)
                                    {
                                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteHistory(h.PaymentId)">Xóa</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <button class="btn btn-secondary" @onclick="() => _showDetail = false">Đóng</button>
            </div>
        </div>
    }

    @if (_showDiscountManager)
    {
        <div class="modal-backdrop" @onclick="CloseDiscountManager">
            <div class="modal-content modal-tuition" @onclick:stopPropagation="true">
                <h3>Quản lý giảm phí tháng @_month.ToString("D2")/@_year</h3>
                <p class="text-muted">Danh sách học viên đang được giảm phí. Chỉ tài khoản nhatduck được chỉnh sửa.</p>
                @if (!string.IsNullOrEmpty(_discountManagerMessage))
                {
                    <div class="alert @(_discountManagerIsError ? "alert-danger" : "alert-success")">@_discountManagerMessage</div>
                }
                @if (_discountManagerRows.Count == 0)
                {
                    <p class="text-muted">Không có học viên được giảm phí trong tháng này.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table compact">
                            <thead>
                                <tr>
                                    <th>Họ tên</th>
                                    <th>Lớp</th>
                                    <th>% giảm</th>
                                    <th>Ghi chú</th>
                                    <th>Học phí tháng</th>
                                    <th>Nợ chuyển</th>
                                    <th>Tiền giảm</th>
                                    <th>Cần đóng</th>
                                    <th>Đã đóng</th>
                                    <th>Còn lại</th>
                                    <th>Người tạo</th>
                                    <th>Thời gian</th>
                                    @if (Session.CanEditTuitionDiscountManagement)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _discountManagerRows)
                                {
                                    var editing = _editingDiscountStudentId == item.StudentId;
                                    <tr>
                                        <td>@item.StudentName</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.ClassNames) ? "-" : item.ClassNames)</td>
                                        <td>
                                            @if (editing)
                                            {
                                                <input type="number" min="0" max="100" step="0.5" @bind="_editDiscountPercentText" />
                                            }
                                            else
                                            {
                                                @FormatPercent(item.DiscountPercent)
                                            }
                                        </td>
                                        <td>
                                            @if (editing)
                                            {
                                                <input @bind="_editDiscountNote" />
                                            }
                                            else
                                            {
                                                @(string.IsNullOrWhiteSpace(item.Note) ? "-" : item.Note)
                                            }
                                        </td>
                                        <td>@MoneyHelper.FormatCurrency(item.TotalGrossAttendance)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.TotalCarryOver)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.TotalDiscountAmount)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.TotalDueAfterDiscount)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.TotalPaid)</td>
                                        <td class="amount-remaining">@MoneyHelper.FormatCurrency(item.TotalRemainingAfterDiscount)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.CreatedByUsername) ? "-" : item.CreatedByUsername)</td>
                                        <td>@FormatDiscountCreatedAt(item.CreatedAt)</td>
                                        @if (Session.CanEditTuitionDiscountManagement)
                                        {
                                            <td>
                                                @if (item.IsLocked)
                                                {
                                                    <span class="text-muted">Đã chốt</span>
                                                }
                                                else if (editing)
                                                {
                                                    <div class="table-actions">
                                                        <button class="btn btn-primary btn-sm" @onclick="() => SaveManagedDiscount(item.StudentId)">Lưu</button>
                                                        <button class="btn btn-secondary btn-sm" @onclick="CancelEditManagedDiscount">Hủy</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="table-actions">
                                                        <button class="btn btn-secondary btn-sm" @onclick="() => BeginEditManagedDiscount(item)">Sửa</button>
                                                        <button class="btn btn-danger btn-sm" @onclick="() => ClearManagedDiscount(item)">Xóa giảm</button>
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <button class="btn btn-secondary" @onclick="CloseDiscountManager">Đóng</button>
            </div>
        </div>
    }

    @if (_showDiscountModal)
    {
        <div class="modal-backdrop" @onclick="CloseDiscountModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Giảm phí - @_discountStudentName</h3>
                <p class="text-muted">Tháng @_month:D2/@_year</p>

                @if (_discountPreview is not null)
                {
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Phần trăm giảm (%)</label>
                            <input type="number"
                                   min="0"
                                   max="100"
                                   step="0.01"
                                   value="@_discountPercentText"
                                   @oninput="OnDiscountPercentChanged"
                                   disabled="@_discountPreview.IsLocked" />
                        </div>
                        <div class="form-group">
                            <label>Ghi chú lý do giảm</label>
                            <input value="@_discountNote"
                                   @oninput="OnDiscountNoteChanged"
                                   placeholder="Ví dụ: Học 2 lớp, giảm theo chính sách..."
                                   disabled="@_discountPreview.IsLocked" />
                        </div>
                    </div>

                    <div class="summary-box" style="margin-bottom: 1rem;">
                        <span>Tổng trước giảm: @MoneyHelper.FormatCurrency(_discountPreview.TotalDiscountableBase)</span>
                        <span class="text-muted">(học phí tháng: @MoneyHelper.FormatCurrency(_discountPreview.TotalGrossAttendance), nợ chuyển: @MoneyHelper.FormatCurrency(_discountPreview.TotalCarryOver))</span>
                        <span>Được giảm (@FormatPercent(_discountPreview.DiscountPercent)): @MoneyHelper.FormatCurrency(_discountPreview.TotalDiscountAmount)</span>
                        <span>Còn phải đóng: @MoneyHelper.FormatCurrency(_discountPreview.TotalDueAfterDiscount)</span>
                        <span>Còn lại: @MoneyHelper.FormatCurrency(_discountPreview.TotalRemainingAfterDiscount)</span>
                    </div>

                    @if (_discountPreview.ClassAllocations.Any(a => a.DiscountableBase > 0))
                    {
                        <div class="table-responsive" style="margin-bottom: 1rem;">
                            <table class="data-table compact">
                                <thead>
                                    <tr><th>Lớp</th><th>Tổng trước giảm</th><th>Giảm</th><th>Cần đóng</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _discountPreview.ClassAllocations.Where(a => a.DiscountableBase > 0))
                                    {
                                        <tr>
                                            <td>@item.ClassName</td>
                                            <td>@MoneyHelper.FormatCurrency(item.DiscountableBase)</td>
                                            <td>@MoneyHelper.FormatCurrency(item.DiscountAllocated)</td>
                                            <td>@MoneyHelper.FormatCurrency(item.TotalDue)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (_discountPreview.IsLocked)
                    {
                        <p class="text-muted">Tháng này đã chốt số liệu ở ít nhất một lớp, không thể sửa giảm phí.</p>
                    }
                }

                <button class="btn btn-primary" @onclick="SaveDiscount" disabled="@(_discountPreview?.IsLocked == true)">Lưu giảm phí</button>
                <button class="btn btn-secondary" @onclick="CloseDiscountModal">Đóng</button>
            </div>
        </div>
    }

    @if (_showFinalizeConfirm)
    {
        <div class="modal-backdrop" @onclick="CloseFinalizeConfirm">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>@(_classId <= 0 ? "Xác nhận chốt hàng loạt" : "Xác nhận chốt số liệu")</h3>
                @if (_classId <= 0)
                {
                    <p>Bạn có chắc muốn chốt hàng loạt tháng @_month:D2/@_year cho toàn bộ @_pendingFinalizeCount lớp chưa chốt?</p>
                }
                else
                {
                    <p>Bạn có chắc muốn chốt số liệu tháng @_month:D2/@_year cho lớp đang chọn?</p>
                }
                <p class="text-muted">Sau khi chốt:</p>
                <ul class="text-muted">
                    <li>Không thể thu học phí, sửa hoặc xóa lịch sử thu của tháng này.</li>
                    <li>Số tiền còn nợ sẽ được chuyển sang tháng sau.</li>
                </ul>
                <button class="btn btn-primary" @onclick="ConfirmFinalizeMonth">Xác nhận chốt</button>
                <button class="btn btn-secondary" @onclick="CloseFinalizeConfirm">Hủy</button>
            </div>
        </div>
    }
}

@code {
    private List<ClassInfo> _classes = new();
    private List<PaymentClassListRow> _allPaymentRows = new();
    private int _classId;
    private int _month = DateTime.Now.Month;
    private int _year = DateTime.Now.Year;
    private string _searchText = "";
    private int _currentPage = 1;
    private int _pageSize = 15;
    private int _selectedStudentId;
    private string _selectedStudentName = "";
    private decimal _paid;
    private decimal _remaining;
    private decimal _balance;
    private string _needText = "";
    private string _amountText = "";
    private string _note = "";
    private string? _message;
    private bool _isError;
    private bool _isFinalized;
    private int _pendingFinalizeCount;
    private bool _showDetail;
    private bool _showMonthDetail;
    private List<ClassTuitionMonthDetail> _monthClassDetails = new();
    private string ClassTuitionExportUrl => $"/api/export/payments-by-class/{_month}/{_year}/{_classId}";
    private bool _showDiscountModal;
    private bool _showDiscountManager;
    private List<StudentTuitionDiscountListItem> _discountManagerRows = new();
    private int? _editingDiscountStudentId;
    private string _editDiscountPercentText = "0";
    private string _editDiscountNote = "";
    private string? _discountManagerMessage;
    private bool _discountManagerIsError;
    private bool _showFinalizeConfirm;
    private int _detailStudentId;
    private int _discountStudentId;
    private string _detailStudentName = "";
    private string _discountStudentName = "";
    private string _discountPercentText = "0";
    private string _discountNote = "";
    private StudentTuitionDiscountPreview? _discountPreview;
    private List<PaymentHistoryRow> _detailHistory = new();
    private List<StudentClassTuitionRow> _detailClassBreakdown = new();
    private decimal _collectibleRemaining;
    private ClassPaymentSummary _summary = new();
    private PaymentMonthBatch? _monthBatch;

    private bool IsCurrentMonth => _month == DateTime.Now.Month && _year == DateTime.Now.Year;
    private bool IsFinalizeButtonDisabled =>
        _classId > 0 ? _isFinalized : _pendingFinalizeCount <= 0;
    private bool CanCollectForSelectedMonth => _classId == 0 && IsCurrentMonth && _collectibleRemaining > 0;
    private bool CanCollectPayment => CanCollectForSelectedMonth && _selectedStudentId > 0;
    private bool CanPayFromBalance => CanCollectPayment && _balance > 0;

    private IEnumerable<StudentClassTuitionRow> VisibleDetailBreakdown =>
        _detailClassBreakdown.Where(HasTuitionActivity);

    private static bool HasTuitionActivity(StudentClassTuitionRow row) =>
        row.TotalDue > 0 || row.Paid > 0 || row.Remaining > 0 || row.CarryOver > 0;

    private IEnumerable<PaymentClassListRow> FilteredPaymentRows =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _allPaymentRows
            : _allPaymentRows.Where(MatchesSearch);

    private int FilteredCount => FilteredPaymentRows.Count();

    private decimal FilteredTotalDue => FilteredPaymentRows.Sum(x => x.SoTienCanDong);

    private decimal FilteredTotalPaid => FilteredPaymentRows.Sum(x => x.SoTien);

    private decimal FilteredTotalRemaining =>
        FilteredPaymentRows.Sum(x => x.SoTienConLai);

    private int TotalPages => PaginationHelper.GetTotalPages(FilteredCount, _pageSize);

    private List<PaymentClassListRow> PagedPaymentRows =>
        PaginationHelper.GetPage(FilteredPaymentRows.ToList(), _currentPage, _pageSize);

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var pages = new List<int>();
            var start = Math.Max(1, _currentPage - 2);
            var end = Math.Min(TotalPages, _currentPage + 2);
            for (var p = start; p <= end; p++)
            {
                pages.Add(p);
            }
            return pages;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAdmin) { Nav.NavigateTo("/login"); return; }

        Loading.Show();
        try
        {
            _classes = await Task.Run(ClassService.GetAll);
            await Task.Run(LoadGrid);
        }
        finally
        {
            Loading.Hide();
        }
    }

    private void LoadGrid()
    {
        _isFinalized = _classId > 0 && PaymentService.IsFinalized(_classId, _month, _year);
        _pendingFinalizeCount = PaymentService.GetPendingFinalizeClassIds(_month, _year).Count;
        _monthBatch = PaymentService.LoadMonthBatch(_classId, _month, _year);
        _summary = _monthBatch.Summary;
        _allPaymentRows = PaymentService.GetPaymentListByClassMonthYear(_classId, _month, _year);
        foreach (var row in _allPaymentRows)
        {
            row.SoTienCanDong = _monthBatch.GetTotalDue(row.StudentId, _classId);
        }

        _allPaymentRows = _allPaymentRows
            .OrderByDescending(row => row.SoTienConLai)
            .ThenBy(row => row.HoVaTen, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        _currentPage = Math.Clamp(_currentPage, 1, TotalPages);

        var selectedStillVisible = _selectedStudentId > 0 && FilteredPaymentRows.Any(x => x.StudentId == _selectedStudentId);
        if (selectedStillVisible)
        {
            SelectPaymentRow(FilteredPaymentRows.First(x => x.StudentId == _selectedStudentId));
        }
        else
        {
            var first = FilteredPaymentRows.FirstOrDefault();
            if (first is not null) SelectPaymentRow(first);
            else { _selectedStudentId = 0; }
        }
    }

    private bool MatchesSearch(PaymentClassListRow row) =>
        row.HoVaTen.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase)
        || row.Lop.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase);

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _currentPage = 1;
    }

    private void OnPageSizeChanged()
    {
        _currentPage = 1;
    }

    private void GoToPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalPages);
    }

    private void OpenMonthDetail()
    {
        _monthClassDetails = BuildMonthClassDetails();
        _showMonthDetail = true;
    }

    private void CloseMonthDetail() => _showMonthDetail = false;

    private void OnMonthDetailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            OpenMonthDetail();
        }
    }

    private List<ClassTuitionMonthDetail> BuildMonthClassDetails() =>
        _monthBatch?.GetDetailsByClass(_allPaymentRows) ?? new();

    private void OnFilterChanged()
    {
        _currentPage = 1;
        LoadGrid();
    }

    private void SelectPaymentRow(PaymentClassListRow row)
    {
        if (row.StudentId <= 0) return;
        _selectedStudentId = row.StudentId;
        _selectedStudentName = row.HoVaTen;

        if (_monthBatch is not null)
        {
            var total = _monthBatch.GetTotalDue(row.StudentId, _classId);
            _paid = _monthBatch.GetPaidAmount(row.StudentId, _classId);
            _remaining = Math.Max(0, total - _paid);
            _collectibleRemaining = _monthBatch.GetCollectibleRemaining(row.StudentId);
            var carryOver = _monthBatch.GetCarryOverAmount(row.StudentId, _classId);
            var discount = _monthBatch.GetDiscount(row.StudentId);
            _needText = $"Cần đóng: {MoneyHelper.FormatCurrency(total)}";
            if (discount.DiscountPercent > 0)
            {
                _needText += $" (đã giảm {FormatPercent(discount.DiscountPercent)}";
                if (!string.IsNullOrWhiteSpace(discount.Note))
                {
                    _needText += $" - {discount.Note.Trim()}";
                }
                _needText += ")";
            }
            if (carryOver > 0) _needText += $" (nợ chuyển từ tháng trước: {MoneyHelper.FormatCurrency(carryOver)})";
            _balance = PaymentService.GetStudentBalance(row.StudentId);
            return;
        }

        var totalFallback = PaymentService.GetTotalTuitionByStudentInClassMonthYear(row.StudentId, _classId, _month, _year);
        _paid = PaymentService.GetPaidAmountByStudentMonthYear(row.StudentId, _month, _year, _classId);
        _remaining = Math.Max(0, totalFallback - _paid);
        _collectibleRemaining = PaymentService.GetStudentCollectibleRemaining(row.StudentId, _month, _year);
        _balance = PaymentService.GetStudentBalance(row.StudentId);
        var carryOverFallback = PaymentService.GetCarryOverAmount(row.StudentId, _classId, _month, _year);
        var discountFallback = PaymentService.GetStudentTuitionDiscount(row.StudentId, _month, _year);
        _needText = $"Cần đóng: {MoneyHelper.FormatCurrency(totalFallback)}";
        if (discountFallback.DiscountPercent > 0)
        {
            _needText += $" (đã giảm {FormatPercent(discountFallback.DiscountPercent)}";
            if (!string.IsNullOrWhiteSpace(discountFallback.Note))
            {
                _needText += $" - {discountFallback.Note.Trim()}";
            }
            _needText += ")";
        }
        if (carryOverFallback > 0) _needText += $" (nợ chuyển từ tháng trước: {MoneyHelper.FormatCurrency(carryOverFallback)})";
    }

    private void OpenDiscountManager()
    {
        _editingDiscountStudentId = null;
        _discountManagerMessage = null;
        _discountManagerIsError = false;
        LoadDiscountManager();
        _showDiscountManager = true;
    }

    private void CloseDiscountManager() => _showDiscountManager = false;

    private void LoadDiscountManager()
    {
        _discountManagerRows = PaymentService.GetTuitionDiscountsForMonth(_classId, _month, _year);
    }

    private void BeginEditManagedDiscount(StudentTuitionDiscountListItem item)
    {
        if (!Session.CanEditTuitionDiscountManagement)
        {
            _discountManagerMessage = "Chỉ tài khoản nhatduck mới được chỉnh sửa giảm phí.";
            _discountManagerIsError = true;
            return;
        }

        _editingDiscountStudentId = item.StudentId;
        _editDiscountPercentText = item.DiscountPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        _editDiscountNote = item.Note;
        _discountManagerMessage = null;
    }

    private void CancelEditManagedDiscount()
    {
        _editingDiscountStudentId = null;
        _discountManagerMessage = null;
    }

    private void SaveManagedDiscount(int studentId)
    {
        if (!TrySaveManagedDiscount(studentId, _editDiscountPercentText, _editDiscountNote))
        {
            return;
        }

        _editingDiscountStudentId = null;
        _discountManagerMessage = "Đã cập nhật giảm phí.";
        _discountManagerIsError = false;
        LoadDiscountManager();
        LoadGrid();
    }

    private void ClearManagedDiscount(StudentTuitionDiscountListItem item)
    {
        if (!TrySaveManagedDiscount(item.StudentId, "0", ""))
        {
            return;
        }

        _editingDiscountStudentId = null;
        _discountManagerMessage = $"Đã xóa giảm phí của {item.StudentName}.";
        _discountManagerIsError = false;
        LoadDiscountManager();
        LoadGrid();
    }

    private bool TrySaveManagedDiscount(int studentId, string percentText, string? note)
    {
        if (!Session.CanEditTuitionDiscountManagement || Session.CurrentUser is null)
        {
            _discountManagerMessage = "Chỉ tài khoản nhatduck mới được chỉnh sửa giảm phí.";
            _discountManagerIsError = true;
            return false;
        }

        if (!decimal.TryParse(percentText.Trim().Replace(',', '.'),
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out var percent))
        {
            _discountManagerMessage = "Phần trăm giảm không hợp lệ.";
            _discountManagerIsError = true;
            return false;
        }

        try
        {
            PaymentService.SaveManagedTuitionDiscount(studentId, _month, _year, percent, Session.CurrentUser.Id, note);
            _message = "Đã cập nhật giảm phí.";
            _isError = false;
            return true;
        }
        catch (Exception ex)
        {
            _discountManagerMessage = ex.Message;
            _discountManagerIsError = true;
            return false;
        }
    }

    private static string FormatDiscountCreatedAt(string value) =>
        DateTime.TryParse(value, out var date) ? date.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : value;

    private void OpenDiscountModal(PaymentClassListRow row)
    {
        if (!Session.CanManageTuitionDiscount)
        {
            _message = "Bạn không có quyền giảm phí học viên.";
            _isError = true;
            return;
        }

        _discountStudentId = row.StudentId;
        _discountStudentName = row.HoVaTen;
        var currentDiscount = PaymentService.GetStudentTuitionDiscount(row.StudentId, _month, _year);
        _discountPercentText = currentDiscount.DiscountPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        _discountNote = currentDiscount.Note;
        RefreshDiscountPreview();
        _showDiscountModal = true;
        _message = null;
    }

    private void CloseDiscountModal()
    {
        _showDiscountModal = false;
        _discountPreview = null;
        _discountNote = "";
    }

    private void OnDiscountPercentChanged(ChangeEventArgs e)
    {
        _discountPercentText = e.Value?.ToString() ?? "0";
        RefreshDiscountPreview();
    }

    private void OnDiscountNoteChanged(ChangeEventArgs e)
    {
        _discountNote = e.Value?.ToString() ?? "";
        RefreshDiscountPreview();
    }

    private void RefreshDiscountPreview()
    {
        if (_discountStudentId <= 0)
        {
            return;
        }

        if (!decimal.TryParse(_discountPercentText.Trim().Replace(',', '.'),
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out var percent))
        {
            percent = 0;
        }

        _discountPreview = PaymentService.GetStudentTuitionDiscountPreview(
            _discountStudentId,
            _month,
            _year,
            percent,
            _discountNote);
    }

    private void SaveDiscount()
    {
        if (_discountStudentId <= 0)
        {
            return;
        }

        if (!Session.CanManageTuitionDiscount)
        {
            _message = "Bạn không có quyền giảm phí học viên.";
            _isError = true;
            return;
        }

        if (!decimal.TryParse(_discountPercentText.Trim().Replace(',', '.'),
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out var percent))
        {
            _message = "Phần trăm giảm không hợp lệ.";
            _isError = true;
            return;
        }

        if (percent > 0 && string.IsNullOrWhiteSpace(_discountNote))
        {
            _message = "Vui lòng nhập ghi chú lý do giảm phí.";
            _isError = true;
            return;
        }

        try
        {
            PaymentService.SetStudentTuitionDiscount(
                _discountStudentId,
                _month,
                _year,
                percent,
                Session.CurrentUser!.Id,
                _discountNote);
            _message = percent > 0
                ? $"Đã lưu giảm phí {FormatPercent(percent)} cho {_discountStudentName}."
                : $"Đã xóa giảm phí cho {_discountStudentName}.";
            _isError = false;
            _showDiscountModal = false;
            LoadGrid();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private static string FormatPercent(decimal percent) =>
        percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private void CollectPayment()
    {
        if (_selectedStudentId <= 0 || _classId != 0) return;

        if (!MoneyHelper.TryParseMoney(_amountText, out var amount) || amount <= 0)
        {
            _message = "Số tiền thu bắt buộc phải lớn hơn 0.";
            _isError = true;
            return;
        }

        if (amount > _collectibleRemaining)
        {
            _message = $"Số tiền thu không được lớn hơn số còn lại ({MoneyHelper.FormatCurrency(_collectibleRemaining)}).";
            _isError = true;
            return;
        }

        try
        {
            PaymentService.CollectForStudentMonth(
                _selectedStudentId,
                _month,
                _year,
                amount,
                Session.CurrentUser!.Id,
                _note.Trim());
            _message = "Đã thu học phí.";
            _isError = false;
            _amountText = "";
            _note = "";
            LoadGrid();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private void PayFromBalanceSelected()
    {
        if (_selectedStudentId <= 0 || _classId != 0) return;

        if (_balance <= 0)
        {
            _message = "Học viên không có số dư để thanh toán.";
            _isError = true;
            return;
        }

        if (_collectibleRemaining <= 0)
        {
            _message = "Học viên không còn học phí cần đóng.";
            _isError = true;
            return;
        }

        try
        {
            var amount = PaymentService.PayFromBalanceForStudentMonth(
                _selectedStudentId,
                _month,
                _year,
                Session.CurrentUser!.Id);
            _message = $"Đã thanh toán {MoneyHelper.FormatCurrency(amount)} từ số dư.";
            _isError = false;
            LoadGrid();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private void OpenFinalizeConfirm()
    {
        if (_classId > 0)
        {
            if (_isFinalized)
            {
                _message = "Tháng này đã được chốt số liệu rồi.";
                _isError = true;
                return;
            }
        }
        else if (_pendingFinalizeCount <= 0)
        {
            _message = "Tất cả các lớp đã được chốt số liệu cho tháng này.";
            _isError = true;
            return;
        }

        _showFinalizeConfirm = true;
        _message = null;
    }

    private void CloseFinalizeConfirm() => _showFinalizeConfirm = false;

    private void ConfirmFinalizeMonth()
    {
        _showFinalizeConfirm = false;
        FinalizeMonth();
    }

    private void FinalizeMonth()
    {
        try
        {
            if (_classId <= 0)
            {
                var result = PaymentService.FinalizeAllPayments(_month, _year, Session.CurrentUser!.Id);
                _message = result.FinalizedCount > 0
                    ? $"Đã chốt hàng loạt tháng {_month:D2}/{_year}: {result.FinalizedCount} lớp. Đã bỏ qua {result.SkippedAlreadyFinalized} lớp đã chốt trước đó."
                    : "Tất cả các lớp đã được chốt số liệu cho tháng này.";
            }
            else
            {
                PaymentService.FinalizePayment(_classId, _month, _year, Session.CurrentUser!.Id);
                _message = $"Đã chốt số liệu tháng {_month:D2}/{_year}.";
            }

            _isError = false;
            LoadGrid();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private void ShowDetail(PaymentClassListRow row)
    {
        try
        {
            _detailStudentId = row.StudentId;
            _detailStudentName = row.HoVaTen;
            _detailHistory = PaymentService.GetPaymentHistoryByClassMonthYear(row.StudentId, _classId, _month, _year);
            _detailClassBreakdown = _monthBatch?.GetStudentBreakdown(row.StudentId)
                ?? PaymentService.GetStudentTuitionBreakdownByClassMonthYear(row.StudentId, _month, _year);
            _showDetail = true;
            _isError = false;
        }
        catch (Exception ex)
        {
            _showDetail = false;
            _message = $"Không thể tải chi tiết thu phí: {ex.Message}";
            _isError = true;
        }
    }

    private void DeleteHistory(int paymentId)
    {
        if (!Session.CanDeletePaymentHistory)
        {
            _message = "Bạn không có quyền xóa lịch sử thu phí.";
            _isError = true;
            return;
        }

        try
        {
            PaymentService.DeletePaymentHistory(paymentId, _detailStudentId, Session.CurrentUser!);
            _detailHistory = PaymentService.GetPaymentHistoryByClassMonthYear(_detailStudentId, _classId, _month, _year);
            LoadGrid();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

}
