@page "/admin/students"
@rendermode InteractiveServer
@inject UserSession Session
@inject StudentService StudentService
@inject EvaluationService EvaluationService
@inject NavigationManager Nav
@inject LoadingService Loading
@using NhatDucSoftware.Core.Models
@using NhatDucSoftware.Web.Helpers

<PageTitle>Học viên</PageTitle>

@if (!Session.IsAdmin)
{
    <p>Không có quyền truy cập.</p>
}
else
{
    <h1 class="page-title">Quản lý học viên</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info">@_message</div>
    }

    <div class="card">
        <div class="form-grid">
            <div class="form-group">
                <label>Họ tên</label>
                <input @bind="_form.FullName" />
            </div>
            <div class="form-group">
                <label>SĐT</label>
                <input @bind="_form.Phone" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input @bind="_form.Email" />
            </div>
            <div class="form-group">
                <label>Năm sinh</label>
                <input type="number" @bind="_form.BirthYear" />
            </div>
            <div class="form-group">
                <label>Địa chỉ</label>
                <input @bind="_form.Address" />
            </div>
            <div class="form-group">
                <label>Trạng thái</label>
                <select @bind="_form.Status">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
            <div class="form-group">
                <label>Số dư</label>
                <input @bind="_form.BalanceText" placeholder="0" />
            </div>
        </div>
        <div class="toolbar">
            <button class="btn btn-primary" @onclick="AddStudent">Thêm</button>
            <button class="btn btn-secondary" @onclick="UpdateStudent" disabled="@(_selectedId is null)">Cập nhật</button>
            @if (Session.CanDeleteStudent)
            {
                <button class="btn btn-danger" @onclick="DeleteStudent" disabled="@(_selectedId is null)">Xóa</button>
            }
            <label class="btn btn-secondary btn-file-label">
                Nhập TXT
                <InputFile OnChange="ImportStudents" accept=".txt" />
            </label>
            <a class="btn btn-success" href="/api/export/students" target="_blank">Xuất Excel</a>
            <button class="btn btn-secondary" @onclick="ShowEvaluations" disabled="@(_selectedId is null)">Xem điểm/NX</button>
            <button class="btn btn-secondary" @onclick="ShowBalanceHistory" disabled="@(_selectedId is null)">Lịch sử số dư</button>
        </div>
    </div>

    <div class="card">
        <div class="list-toolbar">
            <div class="search-box">
                <input type="search"
                       placeholder="Tìm theo tên, SĐT, email, lớp, ID..."
                       value="@_searchText"
                       @oninput="OnSearchChanged" />
            </div>
            <div class="list-meta">
                <span>@FilteredCount học viên</span>
                <label>
                    Hiển thị
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    / trang
                </label>
            </div>
        </div>

        <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Họ tên</th>
                    <th>Lớp</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th>Năm sinh</th>
                    <th>Trạng thái</th>
                    <th>Số dư</th>
                </tr>
            </thead>
            <tbody>
                @if (PagedStudents.Count == 0)
                {
                    <tr class="empty-row">
                        <td colspan="8">Không tìm thấy học viên phù hợp.</td>
                    </tr>
                }
                else
                {
                    @foreach (var s in PagedStudents)
                    {
                        <tr class="@(_selectedId == s.Id ? "selected" : "")" @onclick="() => SelectStudent(s)">
                            <td>@s.Id</td>
                            <td>@s.FullName</td>
                            <td>@s.ClassName</td>
                            <td>@s.Phone</td>
                            <td>@s.Email</td>
                            <td>@s.BirthYear</td>
                            <td>@s.Status</td>
                            <td>@MoneyHelper.FormatCurrency(s.Balance)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>

        @if (TotalPages > 1)
        {
            <div class="pagination-bar">
                <button class="btn btn-secondary" @onclick="() => GoToPage(1)" disabled="@(_currentPage <= 1)">«</button>
                <button class="btn btn-secondary" @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">‹</button>
                @foreach (var p in VisiblePages)
                {
                    <button class="btn btn-secondary @(p == _currentPage ? "active" : "")" @onclick="() => GoToPage(p)">@p</button>
                }
                <button class="btn btn-secondary" @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">›</button>
                <button class="btn btn-secondary" @onclick="() => GoToPage(TotalPages)" disabled="@(_currentPage >= TotalPages)">»</button>
                <span class="pagination-info">Trang @_currentPage / @TotalPages</span>
            </div>
        }
    </div>

    @if (_showEvalModal)
    {
        <div class="modal-backdrop" @onclick="CloseEvalModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Điểm / Nhận xét - @_evalStudentName</h3>
                <div class="toolbar">
                    <label>Tháng</label>
                    <select @bind="_evalMonth" @bind:after="LoadEvaluations">
                        @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
                    </select>
                    <label>Năm</label>
                    <select @bind="_evalYear" @bind:after="LoadEvaluations">
                        @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++) { <option value="@y">@y</option> }
                    </select>
                    <a class="btn btn-success" href="@($"/api/export/evaluations/{_selectedId}/{_evalYear}/{_evalMonth}")" target="_blank">Xuất Excel</a>
                    <button class="btn btn-secondary" @onclick="CloseEvalModal">Đóng</button>
                </div>
                <div class="table-responsive">
                <table class="data-table compact">
                    <thead><tr><th>Lớp</th><th>Giáo viên</th><th>Điểm</th><th>Nhận xét</th><th>Ngày</th></tr></thead>
                    <tbody>
                        @foreach (var e in _evaluations)
                        {
                            <tr>
                                <td>@e.Lop</td>
                                <td>@e.GiaoVien</td>
                                <td>@e.Diem</td>
                                <td>@e.NhanXet</td>
                                <td>@e.Ngay</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }

    @if (_showBalanceHistoryModal)
    {
        <div class="modal-backdrop" @onclick="CloseBalanceHistoryModal">
            <div class="modal-content modal-lg" @onclick:stopPropagation="true">
                <h3>Lịch sử số dư — @_balanceHistoryStudentName</h3>
                <div class="toolbar">
                    <button class="btn btn-secondary" @onclick="CloseBalanceHistoryModal">Đóng</button>
                </div>
                <div class="table-responsive">
                    <table class="data-table compact">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Người cập nhật</th>
                                <th>Số dư trước</th>
                                <th>Số dư sau</th>
                                <th>Thay đổi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_balanceHistory.Count == 0)
                            {
                                <tr class="empty-row">
                                    <td colspan="5">Chưa có lịch sử chỉnh sửa số dư.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in _balanceHistory)
                                {
                                    var delta = item.NewBalance - item.OldBalance;
                                    <tr>
                                        <td>@FormatHistoryTime(item.UpdatedAt)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.UpdatedByName) ? $"User #{item.UpdatedBy}" : item.UpdatedByName)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.OldBalance)</td>
                                        <td>@MoneyHelper.FormatCurrency(item.NewBalance)</td>
                                        <td class="@(delta >= 0 ? "status-ok" : "status-missing")">@FormatBalanceDelta(delta)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Student> _students = new();
    private StudentForm _form = new();
    private int? _selectedId;
    private string? _message;
    private bool _showEvalModal;
    private string _evalStudentName = "";
    private int _evalMonth = DateTime.Now.Month;
    private int _evalYear = DateTime.Now.Year;
    private List<StudentEvaluationRow> _evaluations = new();
    private bool _showBalanceHistoryModal;
    private string _balanceHistoryStudentName = "";
    private List<StudentBalanceHistory> _balanceHistory = new();

    private string _searchText = "";
    private int _currentPage = 1;
    private int _pageSize = 15;

    private IEnumerable<Student> FilteredStudents =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _students
            : _students.Where(MatchesSearch);

    private int FilteredCount => FilteredStudents.Count();

    private int TotalPages => PaginationHelper.GetTotalPages(FilteredCount, _pageSize);

    private List<Student> PagedStudents =>
        PaginationHelper.GetPage(FilteredStudents.ToList(), _currentPage, _pageSize);

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var pages = new List<int>();
            var start = Math.Max(1, _currentPage - 2);
            var end = Math.Min(TotalPages, _currentPage + 2);
            for (var p = start; p <= end; p++)
            {
                pages.Add(p);
            }
            return pages;
        }
    }

    protected override void OnInitialized()
    {
        if (!Session.IsAdmin) { Nav.NavigateTo("/login"); return; }
        LoadStudents();
    }

    private bool MatchesSearch(Student s)
    {
        var q = _searchText.Trim();
        return s.FullName.Contains(q, StringComparison.OrdinalIgnoreCase)
            || s.Phone.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (s.Email?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || s.ClassName.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (s.Address?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || s.Status.Contains(q, StringComparison.OrdinalIgnoreCase)
            || s.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
            || (s.BirthYear?.ToString().Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _currentPage = 1;
    }

    private void OnPageSizeChanged()
    {
        _currentPage = 1;
    }

    private void GoToPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalPages);
    }

    private void LoadStudents()
    {
        _students = StudentService.GetAll();
        _currentPage = Math.Clamp(_currentPage, 1, TotalPages);
    }

    private void SelectStudent(Student s)
    {
        _selectedId = s.Id;
        _form = new StudentForm
        {
            FullName = s.FullName,
            Phone = s.Phone,
            Email = s.Email ?? "",
            BirthYear = s.BirthYear,
            Address = s.Address ?? "",
            Status = s.Status,
            BalanceText = s.Balance.ToString("0")
        };
    }

    private bool TryParseBalance(out decimal balance)
    {
        if (string.IsNullOrWhiteSpace(_form.BalanceText))
        {
            balance = 0;
            return true;
        }

        return MoneyHelper.TryParseMoney(_form.BalanceText, out balance) && balance >= 0;
    }

    private bool TryValidateStudentForm()
    {
        if (string.IsNullOrWhiteSpace(_form.FullName))
        {
            _message = "Họ tên không được để trống.";
            return false;
        }

        return true;
    }

    private void AddStudent()
    {
        try
        {
            if (!TryValidateStudentForm()) return;

            if (!TryParseBalance(out var balance))
            {
                _message = "Số dư phải là số không âm.";
                return;
            }

            StudentService.Add(new Student
            {
                FullName = _form.FullName.Trim(),
                Phone = _form.Phone.Trim(),
                Email = string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email.Trim(),
                BirthYear = _form.BirthYear,
                Address = string.IsNullOrWhiteSpace(_form.Address) ? null : _form.Address.Trim(),
                Status = _form.Status,
                Balance = balance
            }, Session.CurrentUser?.Id);
            _message = "Đã thêm học viên.";
            LoadStudents();
            ClearForm();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private void UpdateStudent()
    {
        if (_selectedId is null) return;
        if (Session.CurrentUser is null)
        {
            _message = "Không xác định được người dùng.";
            return;
        }

        try
        {
            if (!TryValidateStudentForm()) return;

            if (!TryParseBalance(out var balance))
            {
                _message = "Số dư phải là số không âm.";
                return;
            }

            StudentService.Update(new Student
            {
                Id = _selectedId.Value,
                FullName = _form.FullName.Trim(),
                Phone = _form.Phone.Trim(),
                Email = string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email.Trim(),
                BirthYear = _form.BirthYear,
                Address = string.IsNullOrWhiteSpace(_form.Address) ? null : _form.Address.Trim(),
                Status = _form.Status,
                Balance = balance
            }, Session.CurrentUser.Id);
            _message = "Đã cập nhật học viên.";
            LoadStudents();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private void DeleteStudent()
    {
        if (!Session.CanDeleteStudent)
        {
            _message = "Bạn không có quyền xóa học viên.";
            return;
        }

        if (_selectedId is null) return;
        try
        {
            StudentService.Delete(_selectedId.Value);
            _message = "Đã xóa học viên.";
            LoadStudents();
            ClearForm();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task ImportStudents(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        Loading.Show();

        try
        {
            var imported = 0;
            var skipped = 0;
            var errors = new List<string>();
            var lineNo = 0;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            while (await reader.ReadLineAsync() is { } line)
            {
                lineNo++;
                var raw = line.Trim();
                if (string.IsNullOrWhiteSpace(raw))
                {
                    skipped++;
                    errors.Add($"Dòng {lineNo}: Dòng trống.");
                    continue;
                }

                var parts = raw.Split('-', 5);
                var fullName = parts.Length > 0 ? parts[0].Trim() : "";
                if (string.IsNullOrWhiteSpace(fullName))
                {
                    skipped++;
                    errors.Add($"Dòng {lineNo}: Họ tên không được để trống.");
                    continue;
                }

                int? birthYear = null;
                if (parts.Length > 3 && !string.IsNullOrWhiteSpace(parts[3]))
                {
                    if (!int.TryParse(parts[3].Trim(), out var y))
                    {
                        skipped++;
                        errors.Add($"Dòng {lineNo}: Năm sinh không hợp lệ '{parts[3].Trim()}'.");
                        continue;
                    }
                    birthYear = y;
                }

                try
                {
                    StudentService.Add(new Student
                    {
                        FullName = fullName,
                        Phone = parts.Length > 1 ? parts[1].Trim() : "",
                        Email = parts.Length > 2 && !string.IsNullOrWhiteSpace(parts[2]) ? parts[2].Trim() : null,
                        BirthYear = birthYear,
                        Address = parts.Length > 4 && !string.IsNullOrWhiteSpace(parts[4]) ? parts[4].Trim() : null,
                        Status = "Active"
                    });
                    imported++;
                }
                catch (Exception ex)
                {
                    skipped++;
                    errors.Add($"Dòng {lineNo}: {ex.Message}");
                }
            }

            _message = $"Đã nhập {imported} học viên. Bỏ qua {skipped} dòng.";
            if (errors.Count > 0)
            {
                _message += " " + string.Join(" ", errors.Take(5));
                if (errors.Count > 5) _message += " ...";
            }
            LoadStudents();
        }
        finally
        {
            Loading.Hide();
        }
    }

    private void ShowEvaluations()
    {
        if (_selectedId is null) return;

        var student = _students.FirstOrDefault(s => s.Id == _selectedId);
        if (student is null)
        {
            _message = "Không tìm thấy học viên đã chọn.";
            return;
        }

        _evalStudentName = student.FullName;
        _showEvalModal = true;
        LoadEvaluations();
    }

    private void LoadEvaluations()
    {
        if (_selectedId is null || _evalMonth is < 1 or > 12) return;

        try
        {
            _evaluations = EvaluationService.GetByStudentInMonth(_selectedId.Value, _evalYear, _evalMonth);
        }
        catch (Exception ex)
        {
            _evaluations = new();
            _message = $"Không thể tải điểm/nhận xét: {ex.Message}";
        }
    }

    private void CloseEvalModal() => _showEvalModal = false;

    private void ShowBalanceHistory()
    {
        if (_selectedId is null) return;

        var student = _students.FirstOrDefault(s => s.Id == _selectedId);
        if (student is null)
        {
            _message = "Không tìm thấy học viên đã chọn.";
            return;
        }

        _balanceHistoryStudentName = student.FullName;
        _balanceHistory = StudentService.GetBalanceHistory(_selectedId.Value);
        _showBalanceHistoryModal = true;
    }

    private void CloseBalanceHistoryModal() => _showBalanceHistoryModal = false;

    private static string FormatHistoryTime(DateTime updatedAt)
    {
        var local = updatedAt.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(updatedAt, DateTimeKind.Utc).ToLocalTime()
            : updatedAt.ToLocalTime();
        return local.ToString("dd/MM/yyyy HH:mm");
    }

    private static string FormatBalanceDelta(decimal delta)
    {
        if (delta == 0) return "0đ";
        var prefix = delta > 0 ? "+" : "";
        return $"{prefix}{MoneyHelper.FormatCurrency(delta)}";
    }

    private void ClearForm()
    {
        _selectedId = null;
        _form = new StudentForm();
    }

    private class StudentForm
    {
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
        public int? BirthYear { get; set; }
        public string Address { get; set; } = "";
        public string Status { get; set; } = "Active";
        public string BalanceText { get; set; } = "0";
    }
}
