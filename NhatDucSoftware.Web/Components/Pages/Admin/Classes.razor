@page "/admin/classes"
@rendermode InteractiveServer
@inject UserSession Session
@inject ClassService ClassService
@inject CourseService CourseService
@inject TeacherService TeacherService
@inject StudentService StudentService
@inject ClassScheduleService ScheduleService
@inject NavigationManager Nav

<PageTitle>Lớp học</PageTitle>

@if (!Session.IsAdmin)
{
    <p>Không có quyền truy cập.</p>
}
else
{
    <h1 class="page-title">Quản lý lớp học</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info">@_message</div>
    }

    <div class="card">
        <div class="form-grid">
            <div class="form-group">
                <label>Tên lớp</label>
                <input @bind="_className" />
            </div>
            <div class="form-group">
                <label>Khóa học</label>
                <select @bind="_courseId">
                    @foreach (var c in _courses)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Giáo viên</label>
                <select @bind="_teacherId">
                    <option value="0">-- Chọn --</option>
                    @foreach (var t in _teachers)
                    {
                        <option value="@t.Id">@t.FullName</option>
                    }
                </select>
            </div>
        </div>
        <div class="toolbar">
            <button class="btn btn-primary" @onclick="CreateClass">Tạo lớp</button>
            <button class="btn btn-secondary" @onclick="UpdateClass" disabled="@(_selectedClassId is null)">Cập nhật</button>
            <button class="btn btn-danger" @onclick="DeleteClass" disabled="@(_selectedClassId is null)">Xóa lớp</button>
            <button class="btn btn-secondary" @onclick="OpenSchedule" disabled="@(_selectedClassId is null)">Lịch học tuần</button>
        </div>
    </div>

    <div class="card split-grid">
        <div>
            <h3>Danh sách lớp</h3>
            <div class="table-responsive">
            <table class="data-table compact">
                <thead>
                    <tr><th>Tên lớp</th><th>Khóa</th><th>GV</th><th>HS</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in _classes)
                    {
                        <tr class="@(_selectedClassId == c.Id ? "selected" : "")" @onclick="() => SelectClass(c)">
                            <td>@c.ClassName</td>
                            <td>@c.CourseCode</td>
                            <td>@c.TeacherName</td>
                            <td>@c.CurrentSize</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
        <div>
            <h3>Học viên trong lớp</h3>
            <div class="student-add-panel">
                <div class="search-box">
                    <input type="search"
                           placeholder="Tìm theo tên, SĐT, email, ID..."
                           value="@_studentSearchText"
                           @oninput="OnStudentSearchChanged" />
                </div>
                @if (!string.IsNullOrWhiteSpace(_studentSearchText))
                {
                    <div class="student-search-results">
                        @if (FilteredStudentsForAdd.Count == 0)
                        {
                            <div class="student-search-empty">Không tìm thấy học viên phù hợp.</div>
                        }
                        else
                        {
                            @foreach (var s in FilteredStudentsForAdd)
                            {
                                <button type="button"
                                        class="student-search-item @(_addStudentId == s.Id ? "selected" : "")"
                                        @onclick="() => SelectStudentToAdd(s)">
                                    <span class="student-search-name">@s.FullName</span>
                                    <span class="student-search-meta">ID @s.Id · @s.Phone</span>
                                </button>
                            }
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted student-search-hint">Nhập tên, SĐT hoặc ID để tìm học viên thêm vào lớp.</p>
                }
            </div>
            <div class="toolbar">
                <button class="btn btn-primary" @onclick="AddStudentToClass" disabled="@(_selectedClassId is null || _addStudentId <= 0)">Thêm vào lớp</button>
                <button class="btn btn-secondary" @onclick="OpenTransferModal" disabled="@(_selectedClassId is null || _selectedStudentInClassId is null)">Chuyển lớp</button>
                <button class="btn btn-danger" @onclick="RemoveStudentFromClass" disabled="@(_selectedStudentInClassId is null)">Xóa khỏi lớp</button>
            </div>
            <div class="table-responsive">
            <table class="data-table compact">
                <thead><tr><th>ID</th><th>Họ tên</th></tr></thead>
                <tbody>
                    @foreach (var s in _classStudents)
                    {
                        <tr class="@(_selectedStudentInClassId == s.StudentId ? "selected" : "")" @onclick="() => _selectedStudentInClassId = s.StudentId">
                            <td>@s.StudentId</td>
                            <td>@s.FullName</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    @if (_showTransferModal)
    {
        <div class="modal-backdrop" @onclick="CloseTransferModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Chuyển lớp học viên</h3>
                <p><strong>@_transferStudentName</strong> · từ lớp <strong>@_className</strong></p>
                <div class="form-group">
                    <label>Chuyển sang lớp</label>
                    <select @bind="_transferTargetClassId">
                        <option value="0">-- Chọn lớp --</option>
                        @foreach (var c in TransferTargetClasses)
                        {
                            <option value="@c.Id">@c.ClassName (@c.CourseCode)</option>
                        }
                    </select>
                </div>
                <div class="toolbar">
                    <button class="btn btn-primary" @onclick="ConfirmTransfer" disabled="@(_transferTargetClassId <= 0)">Xác nhận chuyển</button>
                    <button class="btn btn-secondary" @onclick="CloseTransferModal">Hủy</button>
                </div>
            </div>
        </div>
    }

    @if (_showSchedule)
    {
        <div class="modal-backdrop" @onclick="() => _showSchedule = false">
            <div class="modal-content modal-lg" @onclick:stopPropagation="true">
                <h3>Lịch học - @_scheduleClassName</h3>
                <div class="toolbar">
                    <label>Tuần</label>
                    <input type="date" @bind="_weekDate" @bind:after="LoadSchedule" />
                    <button class="btn btn-primary" @onclick="SaveSchedule">Lưu lịch tuần này</button>
                    <button class="btn btn-secondary" @onclick="() => _showSchedule = false">Đóng</button>
                </div>
                <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            @for (int s = 1; s <= 5; s++)
                            {
                                <th>@TeacherTimesheet.GetShiftDescription(s)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int d = 0; d < 7; d++)
                        {
                            <tr>
                                <td>@ClassWeeklySchedule.GetDayName(d)</td>
                                @for (int s = 1; s <= 5; s++)
                                {
                                    var day = d;
                                    var shift = s;
                                    <td style="text-align:center">
                                        <input type="checkbox" checked="@GetShiftChecked(day, shift)" @onchange="e => SetShift(day, shift, (bool)(e.Value ?? false))" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<ClassInfo> _classes = new();
    private List<Course> _courses = new();
    private List<Teacher> _teachers = new();
    private List<Student> _allStudents = new();
    private List<(int StudentId, string FullName)> _classStudents = new();
    private int? _selectedClassId;
    private int? _selectedStudentInClassId;
    private string _className = "";
    private int _courseId;
    private int _teacherId;
    private int _addStudentId;
    private string _studentSearchText = "";
    private string? _message;

    private bool _showTransferModal;
    private int _transferTargetClassId;
    private string _transferStudentName = "";

    private bool _showSchedule;
    private string _scheduleClassName = "";
    private DateTime _weekDate = DateTime.Today;
    private HashSet<(int Day, int Shift)> _scheduleShifts = new();

    protected override void OnInitialized()
    {
        if (!Session.IsAdmin) { Nav.NavigateTo("/login"); return; }
        _courses = CourseService.GetAll();
        _teachers = TeacherService.GetAll();
        _allStudents = StudentService.GetAll();
        if (_courses.Count > 0) _courseId = _courses[0].Id;
        LoadClasses();
    }

    private void LoadClasses() => _classes = ClassService.GetAll();

    private HashSet<int> ClassStudentIds => _classStudents.Select(s => s.StudentId).ToHashSet();

    private List<Student> FilteredStudentsForAdd
    {
        get
        {
            var q = _studentSearchText.Trim();
            if (string.IsNullOrWhiteSpace(q))
            {
                return new List<Student>();
            }

            return _allStudents
                .Where(s => !ClassStudentIds.Contains(s.Id) && MatchesStudentSearch(s, q))
                .Take(20)
                .ToList();
        }
    }

    private IEnumerable<ClassInfo> TransferTargetClasses =>
        _classes.Where(c => c.Id != _selectedClassId);

    private bool MatchesStudentSearch(Student s, string q) =>
        s.FullName.Contains(q, StringComparison.OrdinalIgnoreCase)
        || s.Phone.Contains(q, StringComparison.OrdinalIgnoreCase)
        || (s.Email?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || s.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase);

    private void OnStudentSearchChanged(ChangeEventArgs e)
    {
        _studentSearchText = e.Value?.ToString() ?? "";
        _addStudentId = 0;
    }

    private void SelectStudentToAdd(Student s)
    {
        _addStudentId = s.Id;
        _studentSearchText = s.FullName;
    }

    private void SelectClass(ClassInfo c)
    {
        _selectedClassId = c.Id;
        _className = c.ClassName;
        _courseId = c.CourseId;
        _teacherId = c.TeacherId ?? 0;
        _classStudents = ClassService.GetStudentsInClass(c.Id);
        _selectedStudentInClassId = null;
        _addStudentId = 0;
        _studentSearchText = "";
    }

    private void CreateClass()
    {
        ClassService.AddClass(_className.Trim(), _courseId, _teacherId > 0 ? _teacherId : null, "Active");
        _message = "Đã tạo lớp.";
        LoadClasses();
    }

    private void UpdateClass()
    {
        if (_selectedClassId is null) return;
        ClassService.UpdateClass(_selectedClassId.Value, _className.Trim(), _courseId, _teacherId > 0 ? _teacherId : null);
        _message = "Đã cập nhật lớp.";
        LoadClasses();
    }

    private void DeleteClass()
    {
        if (_selectedClassId is null) return;
        try
        {
            ClassService.DeleteClass(_selectedClassId.Value);
            _message = "Đã xóa lớp.";
            _selectedClassId = null;
            _classStudents.Clear();
            LoadClasses();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private void AddStudentToClass()
    {
        if (_selectedClassId is null || _addStudentId <= 0) return;
        try
        {
            ClassService.AddStudentToClass(_selectedClassId.Value, _addStudentId);
            _classStudents = ClassService.GetStudentsInClass(_selectedClassId.Value);
            LoadClasses();
            _addStudentId = 0;
            _studentSearchText = "";
            _message = "Đã thêm học viên vào lớp.";
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private void RemoveStudentFromClass()
    {
        if (_selectedClassId is null || _selectedStudentInClassId is null) return;
        ClassService.RemoveStudentFromClass(_selectedClassId.Value, _selectedStudentInClassId.Value);
        _classStudents = ClassService.GetStudentsInClass(_selectedClassId.Value);
        _selectedStudentInClassId = null;
        LoadClasses();
        _message = "Đã xóa học viên khỏi lớp.";
    }

    private void OpenTransferModal()
    {
        if (_selectedClassId is null || _selectedStudentInClassId is null) return;

        var student = _classStudents.FirstOrDefault(s => s.StudentId == _selectedStudentInClassId);
        _transferStudentName = student.FullName;
        _transferTargetClassId = 0;
        _showTransferModal = true;
    }

    private void CloseTransferModal() => _showTransferModal = false;

    private void ConfirmTransfer()
    {
        if (_selectedClassId is null || _selectedStudentInClassId is null || _transferTargetClassId <= 0) return;

        try
        {
            ClassService.TransferStudentToClass(_selectedClassId.Value, _transferTargetClassId, _selectedStudentInClassId.Value);
            _classStudents = ClassService.GetStudentsInClass(_selectedClassId.Value);
            _selectedStudentInClassId = null;
            LoadClasses();
            _showTransferModal = false;
            _message = "Đã chuyển học viên sang lớp mới.";
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private void OpenSchedule()
    {
        if (_selectedClassId is null) return;
        _scheduleClassName = _className;
        _weekDate = DateTime.Today;
        _showSchedule = true;
        LoadSchedule();
    }

    private void LoadSchedule()
    {
        if (_selectedClassId is null) return;
        var monday = ClassWeeklySchedule.GetMondayOfWeek(_weekDate);
        var schedule = ScheduleService.GetScheduleForWeek(_selectedClassId.Value, monday);
        _scheduleShifts = schedule.Select(x => (x.DayOfWeek, x.ShiftNumber)).ToHashSet();
    }

    private bool GetShiftChecked(int day, int shift) => _scheduleShifts.Contains((day, shift));

    private void SetShift(int day, int shift, bool value)
    {
        if (value) _scheduleShifts.Add((day, shift));
        else _scheduleShifts.Remove((day, shift));
    }

    private void SaveSchedule()
    {
        if (_selectedClassId is null) return;
        var monday = ClassWeeklySchedule.GetMondayOfWeek(_weekDate);
        var entries = _scheduleShifts.Select(x => (x.Day, x.Shift)).ToList();
        ScheduleService.SaveScheduleForWeek(_selectedClassId.Value, monday, entries);
        _message = "Đã lưu lịch học!";
        _showSchedule = false;
    }
}
