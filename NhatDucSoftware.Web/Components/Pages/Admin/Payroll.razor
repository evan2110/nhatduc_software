@page "/admin/payroll"
@rendermode InteractiveServer
@inject UserSession Session
@inject TeacherService TeacherService
@inject TeacherTimesheetService TimesheetService
@inject AttendanceService AttendanceService
@inject ClassService ClassService
@inject PaymentService PaymentService
@inject TeacherTimesheetNotificationService PayrollEmailService
@inject NavigationManager Nav
@using NhatDucSoftware.Core.Helpers
@using NhatDucSoftware.Core.Models
@using NhatDucSoftware.Web.Helpers

<PageTitle>Ngày công</PageTitle>

@if (!Session.IsAdmin)
{
    <p>Không có quyền truy cập.</p>
}
else
{
    <h1 class="page-title">Ngày công giáo viên</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-info">@_message</div>
    }

    <div class="card">
        <div class="toolbar">
            <label>Tháng</label>
            <select @bind="_month" @bind:after="LoadPayroll">
                @for (int m = 1; m <= 12; m++) { <option value="@m">@m</option> }
            </select>
            <label>Năm</label>
            <select @bind="_year" @bind:after="LoadPayroll">
                @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++) { <option value="@y">@y</option> }
            </select>
            @if (Session.CanManagePaySettings)
            {
                <button class="btn btn-secondary" @onclick="OpenPaySettings">Cài đặt lương/ca</button>
            }
            <button class="btn btn-secondary" @onclick="OpenMakeupTimesheet" disabled="@(_selectedTeacherId is null)">Chấm công bù GV</button>
            <button class="btn btn-secondary" @onclick="OpenMakeupAttendance">Điểm danh bù HS</button>
            <button class="btn btn-success" @onclick="OpenExportModal">Xuất Excel điểm danh & chấm công</button>
        </div>

        <div class="split-grid">
            <div class="table-responsive">
            <table class="data-table compact">
                <thead><tr><th>Giáo viên</th><th>Tổng ca</th><th>Lương</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in _payrollRows)
                    {
                        <tr class="@(_selectedTeacherId == row.TeacherId ? "selected" : "")" @onclick="() => SelectTeacher(row)">
                            <td>@row.Name</td>
                            <td>@row.TotalShifts</td>
                            <td>@MoneyHelper.FormatCurrency(row.Pay)</td>
                            <td>
                                <button class="btn btn-primary btn-sm"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => SendPayrollEmail(row)"
                                        disabled="@(_sendingPayrollTeacherId == row.TeacherId)">
                                    @(_sendingPayrollTeacherId == row.TeacherId ? "Đang gửi..." : "Gửi mail công")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <div>
                <h3>Chi tiết ca</h3>
                @if (_selectedTeacherId is null)
                {
                    <p class="text-muted">Chọn giáo viên để xem chi tiết ca.</p>
                }
                else
                {
                    <div class="list-toolbar detail-filter-toolbar">
                        <div class="detail-filter-row detail-date-filter">
                            <div class="detail-date-filter-group">
                                <span class="detail-date-filter-label">Ngày</span>
                                <div class="detail-date-filter-actions">
                                    <input type="date"
                                           value="@DetailFilterDateString"
                                           @onchange="OnDetailFilterDateChanged" />
                                    <button class="btn btn-secondary"
                                            @onclick="ClearDetailDateFilter"
                                            disabled="@(_detailFilterDate is null)">
                                        Xóa lọc ngày
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="list-meta">
                            <span>@FilteredDetailCount ca</span>
                            <label>
                                Hiển thị
                                <select @bind="_detailPageSize" @bind:after="ResetDetailPage">
                                    <option value="10">10</option>
                                    <option value="15">15</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                </select>
                                / trang
                            </label>
                        </div>
                    </div>
                    <div class="table-responsive">
                    <table class="data-table compact">
                        <thead><tr><th>Ngày</th><th>Ca</th><th>Trạng thái</th><th>Lương ca</th><th>Ghi chú</th></tr></thead>
                        <tbody>
                            @if (PagedDetailRecords.Count == 0)
                            {
                                <tr class="empty-row">
                                    <td colspan="5">Không tìm thấy ca phù hợp.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in PagedDetailRecords)
                                {
                                    <tr>
                                        <td>@r.WorkDate.ToString("yyyy-MM-dd")</td>
                                        <td>@r.ShiftNumber</td>
                                        <td>@(r.IsPresent ? "Có mặt" : "Vắng")</td>
                                        <td>@(r.IsPresent ? MoneyHelper.FormatCurrency(r.ShiftPay) : "-")</td>
                                        <td>@r.Note</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    </div>

                    @if (DetailTotalPages > 1)
                    {
                        <div class="pagination-bar">
                            <button class="btn btn-secondary" @onclick="() => GoToDetailPage(1)" disabled="@(_detailCurrentPage <= 1)">«</button>
                            <button class="btn btn-secondary" @onclick="() => GoToDetailPage(_detailCurrentPage - 1)" disabled="@(_detailCurrentPage <= 1)">‹</button>
                            @foreach (var p in DetailVisiblePages)
                            {
                                <button class="btn btn-secondary @(p == _detailCurrentPage ? "active" : "")" @onclick="() => GoToDetailPage(p)">@p</button>
                            }
                            <button class="btn btn-secondary" @onclick="() => GoToDetailPage(_detailCurrentPage + 1)" disabled="@(_detailCurrentPage >= DetailTotalPages)">›</button>
                            <button class="btn btn-secondary" @onclick="() => GoToDetailPage(DetailTotalPages)" disabled="@(_detailCurrentPage >= DetailTotalPages)">»</button>
                            <span class="pagination-info">Trang @_detailCurrentPage / @DetailTotalPages</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (_showPaySettings && Session.CanManagePaySettings)
    {
        <div class="modal-backdrop" @onclick="ClosePaySettings">
            <div class="modal-content modal-lg" @onclick:stopPropagation="true">
                <h3>Cài đặt lương theo lớp</h3>
                <p class="text-muted">Mặc định @MoneyHelper.FormatCurrency(TeacherTimesheet.DefaultPayPerShift)/ca nếu chưa cấu hình. Lương tháng = tổng ca có mặt × lương/ca (lấy mức cao nhất trong các lớp đã cài).</p>
                <div class="form-group">
                    <label>Giáo viên</label>
                    <select @bind="_paySettingsTeacherId" @bind:after="LoadPaySettings">
                        @foreach (var t in _teachers)
                        {
                            <option value="@t.Id">@t.FullName</option>
                        }
                    </select>
                </div>
                @if (_paySettings.Count == 0)
                {
                    <p>Giáo viên này chưa được phân công lớp nào.</p>
                }
                else
                {
                    <div class="table-responsive">
                    <table class="data-table compact">
                        <thead><tr><th>Lớp</th><th>Lương/ca (VNĐ)</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in _paySettings)
                            {
                                <tr @key="item.ClassId">
                                    <td>@item.ClassName</td>
                                    <td>
                                        <input type="number"
                                               min="1"
                                               step="1000"
                                               @bind="item.PayPerShift" />
                                    </td>
                                    <td>
                                        <button class="btn btn-primary btn-sm" @onclick="() => SavePaySetting(item)">Lưu</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
                <button class="btn btn-secondary" @onclick="ClosePaySettings">Đóng</button>
            </div>
        </div>
    }

    @if (_showMakeupTimesheet)
    {
        <div class="modal-backdrop" @onclick="() => _showMakeupTimesheet = false">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Chấm công bù - @_makeupTeacherName</h3>
                @if (!string.IsNullOrEmpty(_makeupMessage))
                {
                    <div class="alert @(_makeupIsError ? "alert-danger" : "alert-success")">@_makeupMessage</div>
                }
                <div class="form-grid">
                    <div class="form-group">
                        <label>Ngày</label>
                        <input type="date" @bind="_makeupDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-group">
                        <label>Ca</label>
                        <select @bind="_makeupShift">
                            @for (int s = 1; s <= 5; s++) { <option value="@s">@TeacherTimesheet.GetShiftDescription(s)</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label><input type="checkbox" @bind="_makeupPresent" /> Có mặt</label>
                    </div>
                    <div class="form-group">
                        <label>Ghi chú</label>
                        <input @bind="_makeupNote" />
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="SaveMakeupTimesheet">Lưu chấm công bù</button>
                <button class="btn btn-secondary" @onclick="() => _showMakeupTimesheet = false">Đóng</button>
            </div>
        </div>
    }

    @if (_showMakeupAttendance)
    {
        <div class="modal-backdrop" @onclick="() => _showMakeupAttendance = false">
            <div class="modal-content modal-lg" @onclick:stopPropagation="true">
                <h3>Điểm danh bù học sinh (Admin)</h3>
                @if (!string.IsNullOrEmpty(_makeupAttMessage))
                {
                    <div class="alert @(_makeupAttIsError ? "alert-danger" : "alert-success")">@_makeupAttMessage</div>
                }
                <div class="toolbar">
                    <label>Lớp</label>
                    <select @bind="_makeupClassId" @bind:after="OnMakeupAttendanceFilterChanged">
                        @foreach (var c in VisibleMakeupClasses)
                        {
                            <option value="@c.Id">@c.ClassName</option>
                        }
                    </select>
                    <label>Ngày</label>
                    <input type="date" @bind="_makeupAttDate" @bind:after="OnMakeupAttendanceFilterChanged" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <label>Ca</label>
                    <select @bind="_makeupAttShift" @bind:after="LoadMakeupStudents" disabled="@(_makeupAttShifts.Count == 0)">
                        @foreach (var shift in _makeupAttShifts)
                        {
                            <option value="@shift">@TeacherTimesheet.GetShiftDescription(shift)</option>
                        }
                    </select>
                    <button class="btn btn-primary" @onclick="SaveMakeupAttendance" disabled="@(!CanSaveMakeupAttendance)">Lưu điểm danh bù</button>
                </div>
                <div class="table-responsive">
                <table class="data-table compact">
                    <thead><tr><th>Học viên</th><th>Điểm danh (C/V)</th></tr></thead>
                    <tbody>
                        @foreach (var row in _makeupAttendanceRows)
                        {
                            <tr>
                                <td>@row.StudentName</td>
                                <td><input class="input-attendance" @bind="row.Status" maxlength="1" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }

    @if (_showExportModal)
    {
        <div class="modal-backdrop" @onclick="CloseExportModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Xuất Excel điểm danh & chấm công</h3>
                <p class="text-muted">Chọn khoảng ngày cần xuất dữ liệu điểm danh học viên và chấm công giáo viên của trung tâm.</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Từ ngày</label>
                        <input type="date" @bind="_exportFromDate" />
                    </div>
                    <div class="form-group">
                        <label>Đến ngày</label>
                        <input type="date" @bind="_exportToDate" />
                    </div>
                </div>
                @if (!CanExportActivity)
                {
                    <p class="text-danger">Từ ngày phải nhỏ hơn hoặc bằng đến ngày.</p>
                }
                @if (CanExportActivity)
                {
                    <a class="btn btn-success" href="@GetActivityExportUrl()" target="_blank" @onclick="CloseExportModal">Xuất Excel</a>
                }
                else
                {
                    <button class="btn btn-success" disabled>Xuất Excel</button>
                }
                <button class="btn btn-secondary" @onclick="CloseExportModal">Đóng</button>
            </div>
        </div>
    }
}

@code {
    private List<Teacher> _teachers = new();
    private List<PayrollRow> _payrollRows = new();
    private List<TimesheetDetailRow> _detailRecords = new();
    private List<ClassInfo> _classes = new();
    private List<TeacherClassPaySetting> _paySettings = new();
    private List<AttendanceRow> _makeupAttendanceRows = new();
    private int _month = DateTime.Now.Month;
    private int _year = DateTime.Now.Year;
    private int? _selectedTeacherId;
    private int _paySettingsTeacherId;
    private string? _message;

    private bool _showPaySettings;
    private bool _showMakeupTimesheet;
    private string _makeupTeacherName = "";
    private DateTime _makeupDate = DateTime.Today;
    private int _makeupShift = 1;
    private bool _makeupPresent = true;
    private string _makeupNote = "";
    private string? _makeupMessage;
    private bool _makeupIsError;

    private bool _showMakeupAttendance;
    private bool _showExportModal;
    private int _makeupClassId;
    private DateTime _makeupAttDate = DateTime.Today;
    private int _makeupAttShift;
    private List<int> _makeupAttShifts = new();
    private string? _makeupAttMessage;
    private bool _makeupAttIsError;

    private DateTime? _detailFilterDate;
    private int _detailCurrentPage = 1;
    private int _detailPageSize = 15;

    private DateTime _exportFromDate = new(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime _exportToDate = new(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month));
    private int? _sendingPayrollTeacherId;

    private string? DetailFilterDateString =>
        _detailFilterDate?.ToString("yyyy-MM-dd");

    private List<ClassInfo> VisibleMakeupClasses =>
        _classes.Where(c => ClassVisibility.IsVisibleForDate(c, _makeupAttDate)).ToList();

    protected override void OnInitialized()
    {
        if (!Session.IsAdmin) { Nav.NavigateTo("/login"); return; }
        _teachers = TeacherService.GetAll();
        _classes = ClassService.GetAll();
        if (_classes.Count > 0) _makeupClassId = _classes[0].Id;
        if (_teachers.Count > 0) _paySettingsTeacherId = _teachers[0].Id;
        LoadPayroll();
    }

    private bool CanExportActivity => _exportFromDate.Date <= _exportToDate.Date;

    private void OpenExportModal()
    {
        _exportFromDate = new DateTime(_year, _month, 1);
        _exportToDate = new DateTime(_year, _month, DateTime.DaysInMonth(_year, _month));
        _showExportModal = true;
    }

    private void CloseExportModal() => _showExportModal = false;

    private string GetActivityExportUrl() =>
        $"/api/export/center-activity?from={_exportFromDate:yyyy-MM-dd}&to={_exportToDate:yyyy-MM-dd}";

    private void LoadPayroll()
    {
        _payrollRows = _teachers.Select(t =>
        {
            var shifts = TimesheetService.GetTotalShiftsInMonth(t.Id, _year, _month);
            return new PayrollRow
            {
                TeacherId = t.Id,
                Name = t.FullName,
                Email = t.Email,
                TotalShifts = shifts,
                Pay = TimesheetService.CalculateMonthlyPay(t.Id, _year, _month),
                ActualWorkingDays = TimesheetService.GetActualWorkingDaysInMonth(t.Id, _year, _month)
            };
        }).ToList();
    }

    private async Task SendPayrollEmail(PayrollRow row)
    {
        if (_sendingPayrollTeacherId is not null)
        {
            return;
        }

        var teacher = _teachers.FirstOrDefault(t => t.Id == row.TeacherId);
        if (teacher is null)
        {
            _message = "Không tìm thấy giáo viên.";
            return;
        }

        _sendingPayrollTeacherId = row.TeacherId;
        _message = null;

        try
        {
            var payroll = new TeacherPayrollEmailData
            {
                Year = _year,
                Month = _month,
                ActualWorkingDays = row.ActualWorkingDays,
                StandardWorkingDays = TeacherTimesheetService.GetStandardWorkingDaysInMonth(_year, _month),
                TotalPay = row.Pay
            };

            var result = await PayrollEmailService.TrySendPayrollEmailAsync(teacher, payroll);
            if (result.Success)
            {
                _message = $"Đã gửi phiếu lương tháng {_month:D2}/{_year} đến {teacher.Email}.";
            }
            else
            {
                _message = result.ErrorMessage;
            }
        }
        finally
        {
            _sendingPayrollTeacherId = null;
        }
    }

    private void SelectTeacher(PayrollRow row)
    {
        _selectedTeacherId = row.TeacherId;
        ResetDetailFilters();
        _detailRecords = TimesheetService.GetTimesheetByMonth(row.TeacherId, _year, _month)
            .Select(r => new TimesheetDetailRow
            {
                WorkDate = r.WorkDate,
                ShiftNumber = r.ShiftNumber,
                IsPresent = r.IsPresent,
                Note = r.Note,
                ShiftPay = r.IsPresent
                    ? TimesheetService.GetShiftPay(row.TeacherId, r.WorkDate, r.ShiftNumber)
                    : 0
            })
            .ToList();
    }

    private IEnumerable<TimesheetDetailRow> FilteredDetailRecords
    {
        get
        {
            if (_detailFilterDate is not DateTime filterDate)
            {
                return _detailRecords;
            }

            return _detailRecords.Where(r => r.WorkDate.Date == filterDate.Date);
        }
    }

    private int FilteredDetailCount => FilteredDetailRecords.Count();

    private int DetailTotalPages => PaginationHelper.GetTotalPages(FilteredDetailCount, _detailPageSize);

    private List<TimesheetDetailRow> PagedDetailRecords =>
        PaginationHelper.GetPage(FilteredDetailRecords.ToList(), _detailCurrentPage, _detailPageSize);

    private IEnumerable<int> DetailVisiblePages
    {
        get
        {
            var pages = new List<int>();
            var start = Math.Max(1, _detailCurrentPage - 2);
            var end = Math.Min(DetailTotalPages, _detailCurrentPage + 2);
            for (var p = start; p <= end; p++)
            {
                pages.Add(p);
            }

            return pages;
        }
    }

    private void ResetDetailFilters()
    {
        _detailFilterDate = null;
        _detailCurrentPage = 1;
    }

    private void ResetDetailPage()
    {
        _detailCurrentPage = 1;
    }

    private void OnDetailFilterDateChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _detailFilterDate = string.IsNullOrWhiteSpace(value) ? null : DateTime.Parse(value);
        ResetDetailPage();
    }

    private void ClearDetailDateFilter()
    {
        _detailFilterDate = null;
        ResetDetailPage();
    }

    private void GoToDetailPage(int page)
    {
        _detailCurrentPage = Math.Clamp(page, 1, DetailTotalPages);
    }

    private void OpenPaySettings()
    {
        if (!Session.CanManagePaySettings)
        {
            _message = "Bạn không có quyền cài đặt lương/ca.";
            return;
        }

        if (_teachers.Count == 0)
        {
            _message = "Chưa có giáo viên để cấu hình lương.";
            return;
        }

        if (_selectedTeacherId is int teacherId)
        {
            _paySettingsTeacherId = teacherId;
        }
        else if (_paySettingsTeacherId <= 0)
        {
            _paySettingsTeacherId = _teachers[0].Id;
        }

        LoadPaySettings();
        _showPaySettings = true;
    }

    private void ClosePaySettings() => _showPaySettings = false;

    private void LoadPaySettings()
    {
        if (_paySettingsTeacherId <= 0) return;
        _paySettings = TimesheetService.GetClassPaySettings(_paySettingsTeacherId);
    }

    private void SavePaySetting(TeacherClassPaySetting item)
    {
        if (!Session.CanManagePaySettings)
        {
            _message = "Bạn không có quyền cài đặt lương/ca.";
            return;
        }

        try
        {
            TimesheetService.SaveClassPayRate(_paySettingsTeacherId, item.ClassId, item.PayPerShift);
            _message = $"Đã lưu lương/ca cho lớp {item.ClassName}.";
            LoadPaySettings();
            LoadPayroll();
            if (_selectedTeacherId == _paySettingsTeacherId)
            {
                var row = _payrollRows.FirstOrDefault(r => r.TeacherId == _paySettingsTeacherId);
                if (row is not null) SelectTeacher(row);
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private void OpenMakeupTimesheet()
    {
        if (_selectedTeacherId is null) return;
        _makeupTeacherName = _payrollRows.First(r => r.TeacherId == _selectedTeacherId).Name;
        _makeupDate = DateTime.Today;
        _makeupMessage = null;
        _makeupIsError = false;
        _showMakeupTimesheet = true;
    }

    private void OpenMakeupAttendance()
    {
        if (_classes.Count == 0)
        {
            _message = "Chưa có lớp để điểm danh bù.";
            return;
        }

        if (_makeupClassId <= 0)
            _makeupClassId = _classes[0].Id;

        _makeupAttDate = DateTime.Today;
        _makeupAttMessage = null;
        _makeupAttIsError = false;
        _showMakeupAttendance = true;
        EnsureMakeupClassSelection();
        OnMakeupAttendanceFilterChanged();
    }

    private void SaveMakeupTimesheet()
    {
        if (_selectedTeacherId is null) return;
        if (_makeupDate.Date > DateTime.Today)
        {
            _makeupMessage = "Chỉ được phép chấm công bù cho các ngày từ hôm nay trở về trước.";
            _makeupIsError = true;
            return;
        }

        TimesheetService.SaveTimesheet(_selectedTeacherId.Value, _makeupDate.Date, _makeupShift, _makeupPresent,
            string.IsNullOrWhiteSpace(_makeupNote) ? null : _makeupNote.Trim());
        _message = "Đã lưu chấm công bù.";
        _makeupMessage = "Đã lưu chấm công bù.";
        _makeupIsError = false;
        LoadPayroll();
        if (_selectedTeacherId is not null)
        {
            var row = _payrollRows.FirstOrDefault(r => r.TeacherId == _selectedTeacherId);
            if (row is not null) SelectTeacher(row);
        }
    }

    private void LoadMakeupShifts()
    {
        _makeupAttShifts = AttendanceService.GetShiftsForClassOnDate(_makeupClassId, _makeupAttDate);
        if (_makeupAttShifts.Count == 0)
        {
            _makeupAttShift = 0;
            return;
        }

        if (!_makeupAttShifts.Contains(_makeupAttShift))
            _makeupAttShift = _makeupAttShifts[0];
    }

    private void OnMakeupAttendanceFilterChanged()
    {
        EnsureMakeupClassSelection();
        LoadMakeupShifts();
        LoadMakeupStudents();
    }

    private void EnsureMakeupClassSelection()
    {
        var visible = VisibleMakeupClasses;
        if (visible.Count == 0)
        {
            _makeupClassId = 0;
            return;
        }

        if (!visible.Any(c => c.Id == _makeupClassId))
        {
            _makeupClassId = visible[0].Id;
        }
    }

    private void LoadMakeupStudents()
    {
        if (_makeupAttShift <= 0)
        {
            _makeupAttendanceRows = new();
            return;
        }

        var saved = AttendanceService.GetAttendanceByClassDateAndShift(_makeupClassId, _makeupAttDate, _makeupAttShift);
        _makeupAttendanceRows = AttendanceService.GetStudentsByClass(_makeupClassId)
            .Select(x => new AttendanceRow
            {
                StudentId = x.StudentId,
                StudentName = x.FullName,
                Status = saved.TryGetValue(x.StudentId, out var status) ? status : ""
            }).ToList();
    }

    private bool CanSaveMakeupAttendance =>
        _makeupAttShift > 0 && _makeupAttendanceRows.Count > 0 && _makeupAttendanceRows.All(x => IsValidStatus(x.Status));

    private static bool IsValidStatus(string? status)
    {
        var n = (status ?? "").Trim().ToUpperInvariant();
        return n is "C" or "V";
    }

    private void SaveMakeupAttendance()
    {
        var teacherId = ClassService.GetTeacherIdByClass(_makeupClassId);
        if (teacherId is null)
        {
            _makeupAttMessage = "Lớp chưa có giáo viên phụ trách, không thể lưu điểm danh bù.";
            _makeupAttIsError = true;
            return;
        }

        if (_makeupAttDate.Date > DateTime.Today)
        {
            _makeupAttMessage = "Chỉ được phép điểm danh bù cho các ngày từ hôm nay trở về trước.";
            _makeupAttIsError = true;
            return;
        }

        if (_makeupAttShift <= 0)
        {
            _makeupAttMessage = "Vui lòng chọn ca học.";
            _makeupAttIsError = true;
            return;
        }

        if (!_makeupAttShifts.Contains(_makeupAttShift))
        {
            _makeupAttMessage = "Lớp không có ca học này trong ngày đã chọn.";
            _makeupAttIsError = true;
            return;
        }

        if (PaymentService.IsFinalized(_makeupClassId, _makeupAttDate.Month, _makeupAttDate.Year))
        {
            _makeupAttMessage = $"Lớp này đã được chốt số liệu cho tháng {_makeupAttDate.Month:D2}/{_makeupAttDate.Year}.";
            _makeupAttIsError = true;
            return;
        }

        var records = _makeupAttendanceRows.ToDictionary(x => x.StudentId, x => x.Status.Trim().ToUpperInvariant());
        AttendanceService.SaveAttendance(_makeupClassId, teacherId.Value, _makeupAttDate, _makeupAttShift, records);
        _message = $"Đã lưu điểm danh bù ca {_makeupAttShift}.";
        _makeupAttMessage = $"Đã lưu điểm danh bù ca {_makeupAttShift}.";
        _makeupAttIsError = false;
        LoadMakeupStudents();
    }

