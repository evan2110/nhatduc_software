@page "/b/{Token}"
@page "/bai-tap/{Token}"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using NhatDucSoftware.Core.Helpers
@inject HomeworkService HomeworkService
@inject HomeworkLinkSubmit SubmitService

<PageTitle>Bài tập</PageTitle>
<HeadContent>
    <meta property="og:title" content="Bài tập" />
</HeadContent>

<div class="hw-public">
    <div class="card">
        @if (_view is null)
        {
            <h1>Không tìm thấy bài tập</h1>
        }
        else
        {
            <h1>@_view.Title</h1>
            <p class="text-muted hw-note">@_view.ClassName · @_view.AssignedOn.ToString("dd/MM/yyyy")</p>
            <p class="hw-prompt">@_view.Prompt</p>
            @if (_view.Kind == HomeworkKind.Written)
            {
                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert @_messageClass">@_message</div>
                }
                <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                    <div class="form-group">
                        <label for="hw-name">Họ và tên học viên</label>
                        <input id="hw-name" required @bind="_studentName" />
                    </div>
                    <div class="form-group">
                        <label for="hw-answer">Đáp án</label>
                        <textarea id="hw-answer" required rows="6" @bind="_answer"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary" disabled="@_busy">Nộp bài</button>
                </form>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert @_messageClass">@_message</div>
                }
                <form @onsubmit="SubmitSpeakingAsync" @onsubmit:preventDefault>
                    <div class="form-group">
                        <label for="hw-name">Họ và tên học viên</label>
                        <input id="hw-name" required @bind="_studentName" />
                    </div>
                    <div class="form-group">
                        <label>Video hoặc ghi âm</label>
                        <div class="hw-work-file">
                            <span class="hw-file-name">@(_mediaName ?? "")</span>
                            <label class="btn btn-secondary btn-sm hw-pick">
                                Chọn file
                                <InputFile @key="@_fileVersion" OnChange="OnMedia" accept=".mp3,.m4a,.wav,.mp4,.webm,.mov" />
                            </label>
                        </div>
                        <p class="text-muted hw-note">Tối đa 15MB.</p>
                    </div>
                    <button type="submit" class="btn btn-primary" disabled="@(_busy || _reading)">@(_reading ? "Đang tải file..." : _busy ? "Đang chấm..." : "Nộp bài")</button>
                </form>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = "";

    private HomeworkPublicView? _view;
    private string _studentName = "";
    private string _answer = "";
    private byte[]? _mediaBytes;
    private string? _mediaName;
    private int _fileVersion;
    private string? _message;
    private string _messageClass = "alert-success";
    private bool _busy;
    private bool _reading;

    protected override void OnParametersSet()
    {
        _view = HomeworkService.GetPublicView(Token);
    }

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var message = await SubmitService.Submit(Token, _studentName, _answer);
            var saved = message.StartsWith("Đã nộp", StringComparison.Ordinal) || message.StartsWith("Đã lưu", StringComparison.Ordinal);
            _messageClass = saved ? "alert-success" : "alert-danger";
            _message = message;
            if (saved)
            {
                _answer = "";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnMedia(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _mediaBytes = null;
        _mediaName = null;
        if (!HomeworkSpeakingUpload.TryAccept(file.Name, file.Size, out var error))
        {
            _message = error;
            _messageClass = "alert-danger";
            return;
        }

        _reading = true;
        _message = null;
        try
        {
            await using var stream = file.OpenReadStream(HomeworkFileRules.MaxBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            if (!HomeworkSpeakingUpload.TryAccept(file.Name, memory.Length, out error))
            {
                _message = error;
                _messageClass = "alert-danger";
                return;
            }

            _mediaBytes = memory.ToArray();
            _mediaName = file.Name;
        }
        catch (Exception)
        {
            _message = "Không đọc được file. Hãy chọn lại.";
            _messageClass = "alert-danger";
        }
        finally
        {
            _reading = false;
        }
    }

    private async Task SubmitSpeakingAsync()
    {
        if (_busy || _reading)
        {
            return;
        }

        if (_mediaBytes is null || _mediaBytes.Length == 0)
        {
            _message = HomeworkSpeakingUpload.MissingFile;
            _messageClass = "alert-danger";
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var message = await SubmitService.SubmitSpeaking(Token, _studentName, _mediaBytes, _mediaName);
            var saved = message.StartsWith("Đã nộp", StringComparison.Ordinal) || message.StartsWith("Đã lưu", StringComparison.Ordinal);
            _messageClass = saved ? "alert-success" : "alert-danger";
            _message = message;
            if (saved)
            {
                _mediaBytes = null;
                _mediaName = null;
                _fileVersion++;
            }
        }
        catch (Exception)
        {
            _messageClass = "alert-danger";
            _message = "Chưa chấm được bài. Hãy thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }
}
