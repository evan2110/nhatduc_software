@page "/notifications"
@page "/home"
@attribute [Authorize(Roles = "Admin,Teacher")]
@rendermode InteractiveServer
@inject UserSession Session
@inject TeacherHomeAlertService AlertService
@inject AnnouncementService AnnouncementService
@inject TeacherService TeacherService
@inject LoadingService Loading
@inject NavigationManager Nav
@using NhatDucSoftware.Core.Helpers
@using NhatDucSoftware.Core.Models
@using NhatDucSoftware.Web.Helpers

<PageTitle>Thông báo</PageTitle>

@if (!Session.IsAuthenticated)
{
    <p>Vui lòng đăng nhập.</p>
}
else
{
    <h1 class="page-title">Thông báo</h1>
    <p class="home-subtitle">
        @(Session.IsAdmin
            ? "Thông báo tổng hợp toàn bộ giáo viên"
            : "Thông báo công việc của bạn")
        — @_bundle.FromDate.ToString("dd/MM/yyyy") → @_bundle.ToDate.ToString("dd/MM/yyyy")
        (nhận xét: tháng @_bundle.Month/@_bundle.Year)
    </p>

    @if (Session.IsAdmin)
    {
        <div class="toolbar">
            <button class="btn btn-primary" @onclick="OpenAnnouncementModal">Tạo bài thông báo</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_announcementMessage))
    {
        <div class="alert alert-success">@_announcementMessage</div>
    }

    @if (_announcements.Count > 0)
    {
        <div class="announcement-list">
            @foreach (var item in _announcements)
            {
                <article class="card announcement-card">
                    <div class="home-alert-header">
                        <h3>@item.Title</h3>
                        @if (Session.IsAdmin)
                        {
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteAnnouncement(item.Id)">Xóa</button>
                        }
                    </div>
                    <p class="announcement-meta">@FormatCreatedAt(item.CreatedAt)</p>
                    <div class="announcement-content">@((MarkupString)AnnouncementHtml.Sanitize(item.Content))</div>
                    @if (item.HasImage)
                    {
                        <img class="announcement-image" src="@($"/announcements/{item.Id}/image")" alt="@item.Title" />
                    }
                </article>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-danger">@_message</div>
    }

    @if (!_bundle.HasAny && string.IsNullOrEmpty(_message))
    {
        <div class="card home-ok-card">
            <p>Không có mục nào cần xử lý trong kỳ hiện tại.</p>
        </div>
    }
    else
    {
        <div class="card home-alert-card home-alert--timesheet">
            <div class="home-alert-header">
                <h3>Thiếu chấm công</h3>
                <span class="home-alert-count">@_bundle.MissingTimesheets.Count</span>
            </div>
            @RenderGapSection(_bundle.MissingTimesheets, _timesheetPage, p => _timesheetPage = p, Session.IsAdmin)
        </div>

        <div class="card home-alert-card home-alert--attendance">
            <div class="home-alert-header">
                <h3>Thiếu điểm danh</h3>
                <span class="home-alert-count">@_bundle.MissingAttendances.Count</span>
            </div>
            @RenderGapSection(_bundle.MissingAttendances, _attendancePage, p => _attendancePage = p, Session.IsAdmin)
        </div>

        <div class="card home-alert-card home-alert--discrepancy">
            <div class="home-alert-header">
                <h3>Chênh lệch chấm công ↔ điểm danh</h3>
                <span class="home-alert-count">@_bundle.Discrepancies.Count</span>
            </div>
            @RenderGapSection(_bundle.Discrepancies, _discrepancyPage, p => _discrepancyPage = p, Session.IsAdmin)
        </div>

        <div class="card home-alert-card home-alert--evaluation">
            <div class="home-alert-header">
                <h3>Chưa có nhận xét (tháng @_bundle.Month/@_bundle.Year)</h3>
                <span class="home-alert-count">@FilteredEvaluations.Count</span>
            </div>
            @if (_bundle.MissingEvaluations.Count == 0)
            {
                <p class="home-alert-empty">Không có.</p>
            }
            else
            {
                <div class="toolbar home-alert-toolbar">
                    <label>Lớp</label>
                    <select @bind="_evaluationClassId" @bind:after="OnEvaluationFilterChanged">
                        <option value="0">Tất cả</option>
                        @foreach (var cls in EvaluationClassOptions)
                        {
                            <option value="@cls.ClassId">@cls.ClassName</option>
                        }
                    </select>
                    <label>
                        Hiển thị
                        <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                        / trang
                    </label>
                </div>

                @if (FilteredEvaluations.Count == 0)
                {
                    <p class="home-alert-empty">Không có học viên phù hợp với lớp đã chọn.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table compact">
                            <thead>
                                <tr>
                                    @if (Session.IsAdmin) { <th>Giáo viên</th> }
                                    <th>Lớp</th>
                                    <th>Học viên</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in PagedEvaluations)
                                {
                                    <tr>
                                        @if (Session.IsAdmin) { <td>@row.TeacherName</td> }
                                        <td>@row.ClassName</td>
                                        <td>@row.StudentName</td>
                                        <td>
                                            @if (Session.IsTeacher)
                                            {
                                                <a class="btn btn-primary btn-sm"
                                                   href="@GetEvaluationDeepLink(row)">
                                                    Bổ sung ngay
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @RenderPager(FilteredEvaluations.Count, _evaluationPage, p => _evaluationPage = p)
                }
            }
        </div>
    }

    @if (_showAnnouncementModal)
    {
        <div class="modal-backdrop" @onclick="CloseAnnouncementModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h3>Tạo bài thông báo</h3>
                <p class="text-muted">Bài đăng hiện ở đầu trang Thông báo của giáo viên.</p>
                @if (!string.IsNullOrEmpty(_announcementFormMessage))
                {
                    <div class="alert alert-danger">@_announcementFormMessage</div>
                }
                <div class="announcement-form">
                    <div class="form-group">
                        <label>Tiêu đề</label>
                        <input @bind="_announcementTitle" maxlength="@AnnouncementService.MaxTitleLength" />
                    </div>
                    <div class="form-group">
                        <label>Nội dung</label>
                        <RichTextEditor @ref="_announcementEditor" />
                    </div>
                    <div class="form-group">
                        <label>Hình ảnh</label>
                        <InputFile OnChange="OnAnnouncementImageSelected" accept="image/jpeg,image/png,image/webp,image/gif" />
                        <p class="text-muted">JPG, PNG, WEBP hoặc GIF. Tối đa 4MB. Có thể bỏ trống.</p>
                        @if (!string.IsNullOrEmpty(_announcementPreviewUrl))
                        {
                            <img class="announcement-preview" src="@_announcementPreviewUrl" alt="Xem trước hình ảnh" />
                        }
                    </div>
                </div>
                <div class="toolbar">
                    <button class="btn btn-primary" @onclick="SaveAnnouncement">Đăng bài</button>
                    <button class="btn btn-secondary" @onclick="CloseAnnouncementModal">Đóng</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private TeacherHomeAlertBundle _bundle = new();
    private List<Announcement> _announcements = new();
    private string? _message;
    private string? _announcementMessage;
    private bool _showAnnouncementModal;
    private string _announcementTitle = "";
    private string _announcementContent = "";
    private RichTextEditor? _announcementEditor;
    private string? _announcementFormMessage;
    private byte[]? _announcementImage;
    private string? _announcementImageType;
    private string? _announcementImageName;
    private string? _announcementPreviewUrl;
    private int _pageSize = 15;
    private int _timesheetPage = 1;
    private int _attendancePage = 1;
    private int _discrepancyPage = 1;
    private int _evaluationPage = 1;
    private int _evaluationClassId;

    private List<TeacherMissingEvaluationAlert> FilteredEvaluations =>
        _evaluationClassId <= 0
            ? _bundle.MissingEvaluations
            : _bundle.MissingEvaluations.Where(x => x.ClassId == _evaluationClassId).ToList();

    private List<(int ClassId, string ClassName)> EvaluationClassOptions =>
        _bundle.MissingEvaluations
            .GroupBy(x => x.ClassId)
            .Select(g => (g.Key, g.First().ClassName))
            .OrderBy(x => x.ClassName)
            .ToList();

    private List<TeacherMissingEvaluationAlert> PagedEvaluations =>
        PaginationHelper.GetPage(FilteredEvaluations, _evaluationPage, _pageSize);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        Loading.Show();
        try
        {
            await Task.Run(LoadPageData);
            ResetPages();
        }
        finally
        {
            Loading.Hide();
        }
    }

    private void LoadPageData()
    {
        string? announcementError = null;
        try
        {
            LoadAnnouncements();
        }
        catch (Exception ex)
        {
            _announcements = new();
            announcementError = $"Không tải được bài thông báo: {ex.Message}";
        }

        LoadAlerts();
        if (announcementError is not null)
        {
            _message = announcementError;
        }
    }

    private void LoadAnnouncements()
    {
        _announcements = AnnouncementService.GetAll();
    }

    private void LoadAlerts()
    {
        try
        {
            if (Session.IsAdmin)
            {
                _bundle = AlertService.GetAlertsForAllTeachers();
                _message = null;
            }
            else if (Session.IsTeacher && Session.CurrentUser?.TeacherId is int teacherId)
            {
                var teacherName = TeacherService.GetAll()
                    .FirstOrDefault(t => t.Id == teacherId)?.FullName
                    ?? Session.CurrentUser.Username;
                _bundle = AlertService.GetAlertsForTeacher(teacherId, teacherName);
                _message = null;
            }
            else
            {
                _message = "Không xác định được tài khoản giáo viên.";
                _bundle = EmptyBundle();
            }
        }
        catch (Exception ex)
        {
            _message = $"Không tải được thông báo: {ex.Message}";
            _bundle = EmptyBundle();
        }
    }

    private static TeacherHomeAlertBundle EmptyBundle() => new()
    {
        FromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1),
        ToDate = DateTime.Today,
        Year = DateTime.Now.Year,
        Month = DateTime.Now.Month
    };

    private void OpenAnnouncementModal()
    {
        _announcementTitle = "";
        _announcementContent = "";
        _announcementFormMessage = null;
        ClearAnnouncementImage();
        _showAnnouncementModal = true;
    }

    private void CloseAnnouncementModal()
    {
        _showAnnouncementModal = false;
        ClearAnnouncementImage();
    }

    private void ClearAnnouncementImage()
    {
        _announcementImage = null;
        _announcementImageType = null;
        _announcementImageName = null;
        _announcementPreviewUrl = null;
    }

    private async Task OnAnnouncementImageSelected(InputFileChangeEventArgs e)
    {
        _announcementFormMessage = null;
        if (e.FileCount == 0)
        {
            ClearAnnouncementImage();
            return;
        }

        var file = e.File;
        if (file.Size > AnnouncementService.MaxImageBytes)
        {
            ClearAnnouncementImage();
            _announcementFormMessage = "Hình ảnh quá lớn. Giới hạn 4MB.";
            return;
        }

        var contentType = file.ContentType;
        if (contentType is not ("image/jpeg" or "image/png" or "image/webp" or "image/gif"))
        {
            ClearAnnouncementImage();
            _announcementFormMessage = "Chỉ nhận hình JPG, PNG, WEBP hoặc GIF.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(AnnouncementService.MaxImageBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _announcementImage = memory.ToArray();
            _announcementImageType = contentType;
            _announcementImageName = file.Name;
            _announcementPreviewUrl = $"data:{contentType};base64,{Convert.ToBase64String(_announcementImage)}";
        }
        catch (Exception ex)
        {
            ClearAnnouncementImage();
            _announcementFormMessage = ex.Message;
        }
    }

    private async Task SaveAnnouncement()
    {
        if (!Session.IsAdmin)
        {
            _announcementFormMessage = "Bạn không có quyền đăng bài thông báo.";
            return;
        }

        try
        {
            _announcementContent = _announcementEditor is null
                ? ""
                : await _announcementEditor.GetHtmlAsync();
            AnnouncementService.Add(
                _announcementTitle,
                _announcementContent,
                _announcementImage,
                _announcementImageType,
                _announcementImageName,
                Session.CurrentUser?.Username);
            LoadAnnouncements();
            _announcementMessage = "Đã đăng bài thông báo.";
            _showAnnouncementModal = false;
            ClearAnnouncementImage();
        }
        catch (Exception ex)
        {
            _announcementFormMessage = ex.Message;
        }
    }

    private void DeleteAnnouncement(int id)
    {
        if (!Session.IsAdmin) return;

        try
        {
            AnnouncementService.Delete(id);
            LoadAnnouncements();
            _announcementMessage = "Đã xóa bài thông báo.";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private static string FormatCreatedAt(string value)
    {
        if (DateTime.TryParse(value, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
        {
            return parsed.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
        }

        return value;
    }

    private void ResetPages()
    {
        _timesheetPage = 1;
        _attendancePage = 1;
        _discrepancyPage = 1;
        _evaluationPage = 1;
        _evaluationClassId = 0;
    }

    private void OnEvaluationFilterChanged()
    {
        _evaluationPage = 1;
    }

    private string GetEvaluationDeepLink(TeacherMissingEvaluationAlert row) =>
        $"/teacher/evaluation?classId={row.ClassId}&studentId={row.StudentId}&month={_bundle.Month}&year={_bundle.Year}";

    private void OnPageSizeChanged()
    {
        ResetPages();
    }

    private RenderFragment RenderGapSection(
        List<TeacherScheduleGapAlert> rows,
        int currentPage,
        Action<int> setPage,
        bool showTeacher) => __builder =>
    {
        if (rows.Count == 0)
        {
            <p class="home-alert-empty">Không có.</p>
            return;
        }

        var paged = PaginationHelper.GetPage(rows, currentPage, _pageSize);

        <div class="toolbar home-alert-toolbar">
            <label>
                Hiển thị
                <select value="@_pageSize" @onchange="e => ChangePageSize(e)">
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
                / trang
            </label>
        </div>

        <div class="table-responsive">
            <table class="data-table compact">
                <thead>
                    <tr>
                        @if (showTeacher) { <th>Giáo viên</th> }
                        <th>Ngày</th>
                        <th>Ca</th>
                        <th>Lớp</th>
                        <th>Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in paged)
                    {
                        <tr>
                            @if (showTeacher) { <td>@row.TeacherName</td> }
                            <td>@row.WorkDate.ToString("dd/MM/yyyy")</td>
                            <td>Ca @row.ShiftNumber</td>
                            <td>@row.ClassName</td>
                            <td>@row.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @RenderPager(rows.Count, currentPage, setPage)
    };

    private void ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            ResetPages();
        }
    }

    private RenderFragment RenderPager(int totalItems, int currentPage, Action<int> setPage) => __builder =>
    {
        var totalPages = PaginationHelper.GetTotalPages(totalItems, _pageSize);
        if (totalPages <= 1)
        {
            return;
        }

        var safePage = Math.Clamp(currentPage, 1, totalPages);
        var start = Math.Max(1, safePage - 2);
        var end = Math.Min(totalPages, safePage + 2);

        <div class="pagination-bar">
            <button class="btn btn-secondary" @onclick="() => setPage(1)" disabled="@(safePage <= 1)">«</button>
            <button class="btn btn-secondary" @onclick="() => setPage(safePage - 1)" disabled="@(safePage <= 1)">‹</button>
            @for (var p = start; p <= end; p++)
            {
                var pageNum = p;
                <button class="btn btn-secondary @(pageNum == safePage ? "active" : "")"
                        @onclick="() => setPage(pageNum)">@pageNum</button>
            }
            <button class="btn btn-secondary" @onclick="() => setPage(safePage + 1)" disabled="@(safePage >= totalPages)">›</button>
            <button class="btn btn-secondary" @onclick="() => setPage(totalPages)" disabled="@(safePage >= totalPages)">»</button>
            <span class="pagination-info">Trang @safePage / @totalPages</span>
        </div>
    };
}
