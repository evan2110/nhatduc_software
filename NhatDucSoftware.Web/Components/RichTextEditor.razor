@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="announcement-editor-host">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    <textarea @ref="_surface"></textarea>
</div>

@code {
    private ElementReference _surface;
    private bool _created;
    private int _version;
    private string? _error;

    protected override bool ShouldRender() => !_created;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_created || _error is not null)
        {
            return;
        }

        var version = ++_version;
        var surface = _surface;
        try
        {
            await JS.InvokeVoidAsync("announcementEditor.create", surface);
            if (version != _version)
            {
                try
                {
                    await JS.InvokeVoidAsync("announcementEditor.destroy", surface);
                }
                catch (JSDisconnectedException)
                {
                }

                return;
            }

            _created = true;
        }
        catch (Exception ex) when (ex is not JSDisconnectedException)
        {
            _error = "Không mở được trình soạn thảo. " + ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task<string> GetHtmlAsync() =>
        await JS.InvokeAsync<string>("announcementEditor.getHtml", _surface);

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("announcementEditor.destroy", _surface);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
