@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="rich-text-editor">
    <div class="rich-text-toolbar" @onmousedown:preventDefault="true">
        <button type="button" class="btn btn-secondary btn-sm" @onclick='() => Exec("bold")'><strong>Đậm</strong></button>
        <button type="button" class="btn btn-secondary btn-sm" @onclick='() => Exec("italic")'><em>Nghiêng</em></button>
        <button type="button" class="btn btn-secondary btn-sm" @onclick='() => Exec("underline")'><u>Gạch chân</u></button>
        <button type="button" class="btn btn-secondary btn-sm" @onclick='() => Exec("insertUnorderedList")'>Danh sách</button>
        <button type="button" class="btn btn-secondary btn-sm" @onclick='() => Exec("insertOrderedList")'>Đánh số</button>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="InsertLink">Liên kết</button>
    </div>
    <div @ref="_surface" class="rich-text-surface" contenteditable="true" data-placeholder="Nhập nội dung thông báo"></div>
</div>

@code {
    private ElementReference _surface;

    public async Task<string> GetHtmlAsync() =>
        await JS.InvokeAsync<string>("announcementEditor.getHtml", _surface);

    private async Task Exec(string command) =>
        await JS.InvokeVoidAsync("announcementEditor.exec", _surface, command, null);

    private async Task InsertLink() =>
        await JS.InvokeVoidAsync("announcementEditor.link", _surface);
}
