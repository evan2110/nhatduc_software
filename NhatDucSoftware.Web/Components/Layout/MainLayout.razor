@inherits LayoutComponentBase
@inject UserSession Session

@if (!Session.IsAuthenticated)
{
    @Body
}
else
{
    <div class="app-shell">
        <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-input" aria-hidden="true" />
        <header class="mobile-header">
            <label for="sidebar-toggle" class="sidebar-toggle-btn" aria-label="Mở menu">
                <span class="hamburger"></span>
            </label>
            <span class="mobile-header-title">Nhat Duc Software</span>
            <span class="mobile-header-user">@Session.CurrentUser!.Username</span>
        </header>
        <label for="sidebar-toggle" class="sidebar-overlay" aria-label="Đóng menu"></label>
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">Nhat Duc Software</div>
                <label for="sidebar-toggle" class="sidebar-close-btn" aria-label="Đóng menu">✕</label>
            </div>
            <div class="sidebar-user">@Session.CurrentUser!.Role: @Session.CurrentUser.Username</div>
            <nav>
                @if (Session.IsAdmin)
                {
                    <NavLink href="/admin/students" Match="NavLinkMatch.All">Học viên</NavLink>
                    <NavLink href="/admin/courses">Khóa học</NavLink>
                    <NavLink href="/admin/classes">Lớp học</NavLink>
                    <NavLink href="/admin/payments">Học phí</NavLink>
                    <NavLink href="/admin/attendance">Điểm danh</NavLink>
                    <NavLink href="/admin/reports">Báo cáo</NavLink>
                    <NavLink href="/admin/expenses">Quản lý chi tiêu</NavLink>
                    <NavLink href="/admin/teachers">Giáo viên</NavLink>
                    <NavLink href="/admin/teacher-schedules">Thời khóa biểu GV</NavLink>
                    <NavLink href="/admin/payroll">Ngày công</NavLink>
                }
                @if (Session.IsTeacher)
                {
                    <NavLink href="/teacher/profile">Hồ sơ GV</NavLink>
                    <NavLink href="/teacher/schedule">Lịch dạy / Lớp</NavLink>
                    <NavLink href="/teacher/attendance">Điểm danh</NavLink>
                    <NavLink href="/teacher/evaluation">Nhận xét / Điểm</NavLink>
                    <NavLink href="/teacher/timesheet">Bảng chấm công</NavLink>
                }
                <a href="/account/logout">Đăng xuất</a>
            </nav>
        </aside>
        <main class="main-content">
            @Body
            <div class="copyright">Make by Nhật Đức</div>
        </main>
    </div>
}

<LoadingOverlay />

<div id="blazor-error-ui">
    Đã xảy ra lỗi chưa xử lý.
    <a href="" class="reload">Tải lại</a>
    <a class="dismiss">🗙</a>
</div>
